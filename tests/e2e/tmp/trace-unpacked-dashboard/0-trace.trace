3b82f6;\n  outline-offset: 2px;\n  transform: translateY(-1px) !important;\n}\n@media (max-width: 640px) {\n  .flex.items-end.gap-3 {\n    gap: 0.5rem;\n  }\n  .w-8 {\n    width: 1.25rem;\n  }\n  .text-xs {\n    font-size: 0.625rem;\n  }\n  .absolute.border-t {\n    right: 0.5rem;\n  }\n}\n@media (prefers-reduced-motion: reduce) {\n  .transition-all,\n  .transition-colors,\n  .transition-opacity,\n  .transform {\n    transition: none;\n  }\n  .hover\\:-translate-y-0\\.5:hover {\n    transform: none;\n  }\n}\n@media (prefers-reduced-motion: reduce) {\n  .optimized-spinner,\n  .optimized-shimmer {\n    animation: none !important;\n  }\n}\n@keyframes optimized-spin {\n  0% {\n    transform: rotate(0deg);\n  }\n  100% {\n    transform: rotate(360deg);\n  }\n}\n.optimized-spinner {\n  animation: optimized-spin 1.5s linear infinite;\n  transform: translateZ(0);\n  will-change: transform;\n}\n@keyframes optimized-shimmer {\n  0% {\n    transform: translateX(-100%);\n    opacity: 0;\n  }\n  50% {\n    opacity: 1;\n  }\n  100% {\n    transform: translateX(100%);\n    opacity: 0;\n  }\n}\n.optimized-shimmer {\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  background: linear-gradient(\n    90deg,\n    transparent,\n    rgba(255, 255, 255, 0.3),\n    transparent\n  );\n  animation: optimized-shimmer 2.5s ease-in-out infinite;\n  transform: translateZ(0);\n  will-change: transform, opacity;\n}\n.optimized-spinner:focus-visible {\n  outline: 2px solid #fbbf24;\n  outline-offset: 2px;\n}\n@property --tw-translate-x {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: 0;\n}\n@property --tw-translate-y {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: 0;\n}\n@property --tw-translate-z {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: 0;\n}\n@property --tw-scale-x {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: 1;\n}\n@property --tw-scale-y {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: 1;\n}\n@property --tw