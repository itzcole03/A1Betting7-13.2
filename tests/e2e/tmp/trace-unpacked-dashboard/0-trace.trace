initial;\n      --tw-duration: initial;\n      --tw-ease: initial;\n      --tw-content: \"\";\n    }\n  }\n}\n</style><style type=\"text/css\" data-vite-dev-id=\"C:/Users/bcmad/Downloads/A1Betting7-13.2/frontend/src/styles/enhanced-animations.css\">/* Enhanced Animations */\r\n\r\n/* Smooth transitions for all elements */\r\n* {\r\n  transition: all 0.2s ease-in-out;\r\n}\r\n\r\n/* Fade in animation */\r\n@keyframes fadeIn {\r\n  from { opacity: 0; }\r\n  to { opacity: 1; }\r\n}\r\n\r\n/* Slide in from left */\r\n@keyframes slideInLeft {\r\n  from { transform: translateX(-100%); }\r\n  to { transform: translateX(0); }\r\n}\r\n\r\n/* Pulse effect */\r\n@keyframes pulse {\r\n  0%, 100% { transform: scale(1); }\r\n  50% { transform: scale(1.05); }\r\n}\r\n\r\n/* Utility classes */\r\n.fade-in {\r\n  animation: fadeIn 0.3s ease-in-out;\r\n}\r\n\r\n.slide-in-left {\r\n  animation: slideInLeft 0.3s ease-in-out;\r\n}\r\n\r\n.pulse-effect {\r\n  animation: pulse 2s infinite;\r\n}\r\n</style><style type=\"text/css\" data-vite-dev-id=\"C:/Users/bcmad/Downloads/A1Betting7-13.2/frontend/src/styles/force-prototype.css\">/* Force Prototype Styles */\r\n\r\n/* Force specific prototype styling overrides */\r\n.force-prototype {\r\n  /* Placeholder for prototype forcing styles */\r\n}\r\n\r\n/* Override default button styles */\r\n.prototype-button {\r\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\r\n  border: none;\r\n  border-radius: 8px;\r\n  color: white;\r\n  padding: 12px 24px;\r\n  font-weight: 600;\r\n  cursor: pointer;\r\n}\r\n\r\n.prototype-button:hover {\r\n  transform: translateY(-2px);\r\n  box-shadow: 0 8px 25px rgba(102, 126, 234, 0.3);\r\n}\r\n</style><style type=\"text/css\" data-vite-dev-id=\"C:/Users/bcmad/Downloads/A1Betting7-13.2/frontend/src/styles/global-cyber-theme.css\">/* Global Cyber Theme */\r\n\r\n/* Global cyber theme application */\r\nbody.cyber-theme {\r\n  background: linear-gradient(135deg, #0a0a0a 0%, #1a1a2e 50%, #16213e 100%);\r\n  color: #00ff41;\r\n  font-family: 'JetBrains Mono', monospace;\r\n}\r\n\r\n/* Cyber theme text effects */\r\n.cyber-text {\r\n  color: #00ff41;\r\n  text-shadow: 0 0 10px #00ff41;\r\n}\r\n\r\n.cyber-text-secondary {\r\n  color: #ff0080;\r\n  text-shadow: 0 0 10px #ff0080;\r\n}\r\n\r\n/* Cyber theme buttons */\r\n.cyber-button {\r\n  background: linear-gradient(45deg, #00ff41, #00cc33);\r\n  border: 1px solid #00ff41;\r\n  color: #000;\r\n  font-weight: bold;\r\n}\r\n\r\n.cyber-button:hover {\r\n  box-shadow: 0 0 20px #00ff41;\r\n  text-shadow: 0 0 5px #000;\r\n}\r\n</style><style type=\"text/css\" data-vite-dev-id=\"C:/Users/bcmad/Downloads/A1Betting7-13.2/frontend/src/styles/prototype-override.css\">/* Prototype Override Styles */\r\n\r\n/* Minimal fallback styles for prototype override */\r\n.prototype-override {\r\n  /* Placeholder for prototype overrides */\r\n}\r\n</style><style type=\"text/css\" data-vite-dev-id=\"C:/Users/bcmad/Downloads/A1Betting7-13.2/frontend/src/styles/quantum-styles.css\">/* Quantum Styles */\r\n\r\n/* Minimal fallback styles for quantum theming */\r\n.quantum-effect {\r\n  /* Placeholder for quantum visual effects */\r\n}\r\n\r\n.quantum-gradient {\r\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\r\n}\r\n\r\n.quantum-glow {\r\n  box-shadow: 0 0 20px rgba(102, 126, 234, 0.3);\r\n}\r\n</style></head>\n  <body data-theme=\"light\">\n    <div id=\"root\"><div data-testid=\"dev-global-controls\"><div style=\"position: fixed; bottom: 80px; right: 12px; z-index: 9999;\"><button data-testid=\"dev-view-dashboard-global\" title=\"Enable demo dashboard (global)\" style=\"background: rgb(6, 182, 212); color: rgb(6, 32, 42); padding: 6px 10px; border-radius: 6px; border: none; cursor: pointer; font-weight: 700;\">Dev: View Dashboard</button></div></div><div data-testid=\"app-gating-state\" data-state=\"auth\" style=\"display: none;\"></div><div class=\"min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 