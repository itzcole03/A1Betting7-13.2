x var(--cyber-primary);\n}\n:root {\n  --primary-50: #eff6ff;\n  --primary-100: #dbeafe;\n  --primary-200: #bfdbfe;\n  --primary-300: #93c5fd;\n  --primary-400: #60a5fa;\n  --primary-500: #3b82f6;\n  --primary-600: #2563eb;\n  --primary-700: #1d4ed8;\n  --primary-800: #1e40af;\n  --primary-900: #1e3a8a;\n  --primary-950: #172554;\n  --electric-400: #06ffa5;\n  --electric-500: #00ff88;\n  --electric-600: #00e676;\n  --neon-pink: #ff10f0;\n  --neon-purple: #7c3aed;\n  --neon-blue: #00d4ff;\n  --neon-green: #39ff14;\n  --neon-orange: #ff6b35;\n  --neon-cyan: #00fff9;\n  --quantum-100: #f0f9ff;\n  --quantum-200: #e0f2fe;\n  --quantum-300: #7dd3fc;\n  --quantum-400: #38bdf8;\n  --quantum-500: #0ea5e9;\n  --quantum-600: #0284c7;\n  --quantum-700: #0369a1;\n  --quantum-800: #075985;\n  --quantum-900: #0c4a6e;\n}\nbody {\n  font-family: 'Inter', system-ui, sans-serif;\n}\n.font-cyber {\n  font-family: 'Orbitron', monospace;\n}\n.font-mono {\n  font-family: 'JetBrains Mono', monospace;\n}\n@keyframes float {\n  0%,\n  100% {\n    transform: translateY(0px) rotateY(0deg);\n  }\n  50% {\n    transform: translateY(-8px) rotateY(5deg);\n  }\n}\n@keyframes glow-pulse {\n  0% {\n    box-shadow: 0 0 20px rgba(0, 255, 136, 0.4),\n      0 0 40px rgba(0, 255, 136, 0.2);\n  }\n  100% {\n    box-shadow: 0 0 40px rgba(0, 255, 136, 0.8),\n      0 0 80px rgba(0, 255, 136, 0.4);\n  }\n}\n@keyframes slide-in-up {\n  0% {\n    opacity: 0;\n    transform: translateY(30px) scale(0.95);\n  }\n  100% {\n    opacity: 1;\n    transform: translateY(0) scale(1);\n  }\n}\n@keyframes slide-in-right {\n  0% {\n    opacity: 0;\n    transform: translateX(30px) scale(0.95);\n  }\n  100% {\n    opacity: 1;\n    transform: translateX(0) scale(1);\n  }\n}\n@keyframes data-flow {\n  0% {\n    transform: translateX(-100%) rotateZ(0deg);\n    opacity: 0;\n  }\n  10% {\n    opacity: 1;\n  }\n  90% {\n    opacity: 1;\n  }\n  100% {\n    transform: translateX(100vw) rotateZ(360deg);\n    opacity: 0;\n  }\n}\n@keyframes matrix-rain {\n  0% {\n    transform: translateY(-100%);\n    opacity: 0;\n  }\n  10% {\n    opacity: 1;\n  }\n  90% {\n    opacity: 1;\n  }\n  100% {\n    transform: translateY(100vh);\n    opacity: 0;\n  }\n}\n@keyframes energy-wave {\n  0% {\n    transform: scaleX(1) scaleY(1);\n    opacity: 1;\n  }\n  50% {\n    transform: scaleX(1.2) scaleY(0.8);\n    opacity: 0.7;\n  }\n  100% {\n    transform: scaleX(1) scaleY(1);\n    opacity: 1;\n  }\n}\n.holographic {\n  background: linear-gradient(45deg, #ff006e, #8338ec, #3a86ff, #06ffa5, #ffbe0b, #ff006e);\n  background-size: 600% 600%;\n  animation: gradient-shift 10s ease infinite,\n    hologram-flicker 3s ease infinite;\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n  font-weight: 900;\n  letter-spacing: 0.05em;\n}\n@keyframes gradient-shift {\n  0% {\n    background-position: 0% 50%;\n  }\n  25% {\n    background-position: 100% 50%;\n  }\n  50% {\n    background-position: 100% 100%;\n  }\n  75% {\n    background-position: 0% 100%;\n  }\n  100% {\n    background-position: 0% 50%;\n  }\n}\n@keyframes hologram-flicker {\n  0%,\n  100% {\n    opacity: 1;\n  }\n  50% {\n    opacity: 0.8;\n  }\n  60% {\n    opacity: 1;\n  }\n  70% {\n    opacity: 0.9;\n  }\n}\n.ultra-glass {\n  background: rgba(255, 255, 255, 0.03);\n  backdrop-filter: blur(25px) saturate(200%);\n  border: 1px solid rgba(255, 255, 255, 0.08);\n  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15),\n    inset 0 1px 0 rgba(255, 255, 255, 0.1);\n}\n.dark .ultra-glass {\n  background: rgba(0, 0, 0, 0.15);\n  border: 1px solid rgba(255, 255, 255, 0.03);\n}\n.quantum-bg {\n  background: radial-gradient(circle at 20% 50%, rgba(0, 255, 136, 0.04) 0%, transparent 50%),\n    radial-gradient(circle at 80% 20%, rgba(124, 58, 237, 0.04) 0%, transparent 50%),\n    radial-gradient(circle at 40% 80%, rgba(0, 212, 255, 0.04) 0%, transparent 50%),\n    linear-gradient(135deg, #0f172a 0%, #1e1b4b 25%, #581c87 50%, #1e1b4b 75%, #0f172a 100%);\n  background-size: 100% 100%,\n    100% 100%,\n    100% 100%,\n    100% 100%;\n  position: relative;\n}\n.quantum-bg::before {\n  content: '';\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background-image: radial-gradient(circle at 25px 25px, rgba(0, 255, 136, 0.1) 2px, transparent 2px),\n    radial-gradient(circle at 75px 75px, rgba(124, 58, 237, 0.1) 2px, transparent 2px);\n  background-size: 100px 100px,\n    150px 150px;\n  opacity: 0.3;\n  animation: matrix-rain 20s linear infinite;\n}\n.quantum-card {\n  background: rgba(255, 255, 255, 0.02);\n  backdrop-filter: blur(30px) saturate(180%);\n  border: 2px solid rgba(255, 255, 255, 0.06);\n  box-shadow: 0 15px 50px rgba(0, 0, 0, 0.2),\n    inset 0 1px 0 rgba(255, 255, 255, 0.1),\n    0 0 30px rgba(0, 255, 136, 0.1);\n  transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);\n  position: relative;\n  overflow: hidden;\n}\n.quantum-card::before {\n  content: '';\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  height: 1px;\n  background: linear-gradient(90deg, transparent, rgba(0, 255, 136, 0.8), transparent);\n  opacity: 0;\n  transition: opacity 0.3s ease;\n}\n.quantum-card:hover::before {\n  opacity: 1;\n}\n.quantum-card:hover {\n  transform: translateY(-8px) scale(1.02);\n  box-shadow: 0 25px 80px rgba(0, 0, 0, 0.3),\n    inset 0 1px 0 rgba(255, 255, 255, 0.2),\n    0 0 50px rgba(0, 255, 136, 0.3);\n  border-color: rgba(0, 255, 136, 0.3);\n}\n@keyframes quantum-spin {\n  0% {\n    transform: rotate(0deg) scale(1);\n  }\n  25% {\n    transform: rotate(90deg) scale(1.1);\n  }\n  50% {\n    transform: rotate(180deg) scale(1);\n  }\n  75% {\n    transform: rotate(270deg) scale(0.9);\n  }\n  100% {\n    transform: rotate(360deg) scale(1);\n  }\n}\n@keyframes neural-pulse {\n  0%,\n  100% {\n    opacity: 0.6;\n    transform: scale(1);\n  }\n  50% {\n    opacity: 1;\n    transform: scale(1.05);\n  }\n}\ninput[type='number'],\ninput[type='text'],\ninput[type='email'],\ninput[type='tel'],\ninput[type='url'],\ninput[type='range'],\nselect,\ntextarea {\n  font-size: 16px !important;\n  background: rgba(255, 255, 255, 0.03) !important;\n  backdrop-filter: blur(15px);\n  border: 2px solid rgba(255, 255, 255, 0.08) !important;\n  color: #ffffff !important;\n  transition: all 0.3s ease;\n}\ninput[type='number']:focus,\ninput[type='text']:focus,\ninput[type='email']:focus,\ninput[type='tel']:focus,\ninput[type='url']:focus,\ninput[type='range']:focus,\nselect:focus,\ntextarea:focus {\n  outline: none;\n  border-color: #00ff88 !important;\n  box-shadow: 0 0 30px rgba(0, 255, 136, 0.4);\n  background: rgba(0, 255, 136, 0.05) !important;\n}\nselect {\n  -webkit-appearance: none;\n     -moz-appearance: none;\n          appearance: none;\n  background-image: url(\"data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2300ff88' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6,9 12,15 18,9'%3e%3c/polyline%3e%3c/svg%3e\");\n  background-repeat: no-repeat;\n  background-position: right 12px center;\n  background-size: 20px;\n  padding-right: 40px;\n}\nselect option {\n  background: #1a1a2e !important;\n  color: #ffffff !important;\n  border: none;\n  padding: 8px 12px;\n}\nselect option:hover,\nselect option:focus {\n  background: rgba(0, 255, 136, 0.1) !important;\n}\n.chat-message {\n  animation: slide-in-up 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);\n}\n.typing-indicator {\n  animation: neural-pulse 2s ease-in-out infinite;\n}\n::-webkit-scrollbar {\n  width: 8px;\n}\n::-webkit-scrollbar-track {\n  background: rgba(0, 0, 0, 0.2);\n  border-radius: 10px;\n}\n::-webkit-scrollbar-thumb {\n  background: linear-gradient(45deg, #00ff88, #00d4ff, #7c3aed);\n  border-radius: 10px;\n  box-shadow: 0 0 10px rgba(0, 255, 136, 0.5);\n}\n.custom-scrollbar {\n  scrollbar-width: thin;\n  scrollbar-color: rgba(0, 255, 136, 0.3) transparent;\n}\n.custom-scrollbar::-webkit-scrollbar {\n  width: 4px;\n}\n.custom-scrollbar::-webkit-scrollbar-track {\n  background: transparent;\n}\n.custom-scrollbar::-webkit-scrollbar-thumb {\n  background: rgba(0, 255, 136, 0.3);\n  border-radius: 2px;\n}\n.custom-scrollbar::-webkit-scrollbar-thumb:hover {\n  background: rgba(0, 255, 136, 0.5);\n}\n@keyframes slide-in-up {\n  0% {\n    opacity: 0;\n    transform: translateY(20px);\n  }\n  100% {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n@keyframes slide-in-right {\n  0% {\n    opacity: 0;\n    transform: translateX(20px);\n  }\n  100% {\n    opacity: 1;\n    transform: translateX(0);\n  }\n}\n@keyframes cyber-pulse {\n  0%,\n  100% {\n    text-shadow: 0 0 10px rgba(0, 255, 136, 0.8);\n  }\n  50% {\n    text-shadow: 0 0 20px rgba(0, 255, 136, 1),\n      0 0 30px rgba(0, 255, 136, 0.8);\n  }\n}\n@keyframes gradient-shift {\n  0% {\n    background-position: 0% 50%;\n  }\n  50% {\n    background-position: 100% 50%;\n  }\n  100% {\n    background-position: 0% 50%;\n  }\n}\n.animate-float {\n  animation: float 6s ease-in-out infinite;\n}\n.animate-glow-pulse {\n  animation: glow-pulse 2s ease-in-out infinite alternate;\n}\n.animate-slide-in-up {\n  animation: slide-in-up 0.6s ease-out;\n}\n.animate-slide-in-right {\n  animation: slide-in-right 0.6s ease-out;\n}\n.animate-cyber-pulse {\n  animation: cyber-pulse 3s ease-in-out infinite;\n}\n.animate-data-flow {\n  animation: data-flow 20s linear infinite;\n}\n.animate-quantum-spin {\n  animation: quantum-spin 8s linear infinite;\n}\n.animate-neural-pulse {\n  animation: neural-pulse 4s ease-in-out infinite;\n}\n.animate-matrix-rain {\n  animation: matrix-rain 15s linear infinite;\n}\n.animate-hologram-flicker {\n  animation: hologram-flicker 2s ease-in-out infinite;\n}\n.animate-energy-wave {\n  animation: energy-wave 3s ease-in-out infinite;\n}\n.float-element {\n  animation: float 4s ease-in-out infinite;\n}\n* {\n  box-sizing: border-box;\n}\nhtml,\nbody {\n  margin: 0;\n  padding: 0;\n  height: 100%;\n  font-family: 'Inter', system-ui, 'Avenir', 'Helvetica', 'Arial', sans-serif;\n  line-height: 1.5;\n  font-weight: 400;\n}\nbody {\n  font-family: 'Inter', system-ui, sans-serif;\n  margin: 0;\n  padding: 0;\n  min-height: 100vh;\n  overflow-x: hidden;\n  color: #ffffff;\n}\n#root {\n  min-height: 100vh;\n  color: #ffffff;\n}\n.glass-card {\n  background: rgba(255, 255, 255, 0.05);\n  backdrop-filter: blur(20px) saturate(180%);\n  border: 1px solid rgba(255, 255, 255, 0.1);\n  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);\n}\n.dark .glass-card {\n  background: rgba(0, 0, 0, 0.2);\n  border: 1px solid rgba(255, 255, 255, 0.05);\n}\n.glass-sidebar {\n  background: rgba(255, 255, 255, 0.02);\n  backdrop-filter: blur(40px) saturate(200%);\n  border: 1px solid rgba(255, 255, 255, 0.05);\n  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2),\n    inset 0 1px 0 rgba(255, 255, 255, 0.05);\n}\n.holographic {\n  background: linear-gradient(45deg, #ff006e, #8338ec, #3a86ff, #06ffa5, #ffbe0b);\n  background-size: 400% 400%;\n  animation: gradient-shift 8s ease infinite;\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n  text-fill-color: transparent;\n}\n.quantum-btn {\n  background: linear-gradient(45deg, #00ff88, #00d4ff, #7c3aed);\n  background-size: 300% 300%;\n  animation: gradient-shift 4s ease infinite;\n  border: none;\n  color: black;\n  font-weight: 800;\n  text-transform: uppercase;\n  letter-spacing: 2px;\n  transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);\n  position: relative;\n  overflow: hidden;\n  font-family: 'Orbitron', monospace;\n}\n.quantum-btn::before {\n  content: '';\n  position: absolute;\n  top: 0;\n  left: -100%;\n  width: 100%;\n  height: 100%;\n  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.6), transparent);\n  transition: left 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);\n}\n.quantum-btn:hover::before {\n  left: 100%;\n}\n.quantum-btn:hover {\n  box-shadow: 0 0 40px rgba(0, 255, 136, 0.8),\n    0 0 80px rgba(0, 255, 136, 0.4);\n  transform: translateY(-3px) scale(1.02);\n}\n.quantum-btn:active {\n  transform: translateY(-1px) scale(0.98);\n}\n.nav-item {\n  transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);\n  border-radius: 16px;\n  margin-bottom: 6px;\n  position: relative;\n  overflow: hidden;\n}\n.nav-item::before {\n  content: '';\n  position: absolute;\n  top: 0;\n  left: -100%;\n  width: 100%;\n  height: 100%;\n  background: linear-gradient(90deg, transparent, rgba(0, 255, 136, 0.1), transparent);\n  transition: left 0.5s ease;\n}\n.nav-item:hover::before {\n  left: 100%;\n}\n.nav-item:hover {\n  background: rgba(0, 255, 136, 0.08);\n  border-left: 6px solid #00ff88;\n  padding-left: 20px;\n  transform: translateX(8px);\n}\n.nav-item.active {\n  background: rgba(0, 255, 136, 0.15);\n  border-left: 6px solid #00ff88;\n  padding-left: 20px;\n  box-shadow: 0 6px 20px rgba(0, 255, 136, 0.4);\n  transform: translateX(8px);\n}\n.prop-card {\n  transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);\n  cursor: pointer;\n  position: relative;\n  overflow: hidden;\n}\n.prop-card:hover {\n  transform: translateY(-6px) scale(1.03) rotateX(5deg);\n  box-shadow: 0 20px 60px rgba(0, 255, 136, 0.2);\n}\n.admin-control {\n  background: rgba(124, 58, 237, 0.08);\n  border: 2px solid rgba(124, 58, 237, 0.2);\n  backdrop-filter: blur(20px);\n  transition: all 0.3s ease;\n}\n.admin-control:hover {\n  background: rgba(124, 58, 237, 0.12);\n  border-color: rgba(124, 58, 237, 0.4);\n  box-shadow: 0 0 30px rgba(124, 58, 237, 0.3);\n}\n.shadow-neon {\n  box-shadow: 0 0 20px rgba(0, 255, 136, 0.6),\n    0 0 40px rgba(0, 255, 136, 0.4);\n}\n.shadow-neon-pink {\n  box-shadow: 0 0 20px rgba(255, 16, 240, 0.6),\n    0 0 40px rgba(255, 16, 240, 0.4);\n}\n.shadow-neon-blue {\n  box-shadow: 0 0 20px rgba(0, 212, 255, 0.6),\n    0 0 40px rgba(0, 212, 255, 0.4);\n}\n.shadow-neon-purple {\n  box-shadow: 0 0 20px rgba(124, 58, 237, 0.6),\n    0 0 40px rgba(124, 58, 237, 0.4);\n}\n.shadow-quantum {\n  box-shadow: 0 0 30px rgba(14, 165, 233, 0.5),\n    0 0 60px rgba(14, 165, 233, 0.3);\n}\n.particle {\n  position: absolute;\n  width: 3px;\n  height: 3px;\n  background: rgba(0, 255, 136, 0.8);\n  border-radius: 50%;\n  animation: particle-float 12s linear infinite;\n  box-shadow: 0 0 6px rgba(0, 255, 136, 0.6);\n}\n@keyframes particle-float {\n  0% {\n    transform: translateY(100vh) translateX(0px) scale(0);\n    opacity: 0;\n  }\n  10% {\n    opacity: 1;\n    transform: translateY(90vh) translateX(10px) scale(1);\n  }\n  90% {\n    opacity: 1;\n  }\n  100% {\n    transform: translateY(-10vh) translateX(-10px) scale(0);\n    opacity: 0;\n  }\n}\n.bg-quantum-grid {\n  background-size: 50px 50px;\n  background-image: radial-gradient(circle at 1px 1px, rgba(0, 255, 136, 0.15) 1px, transparent 0);\n}\n.bg-neural-network {\n  background-image: url(\"data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%2300ff88' fill-opacity='0.1'%3E%3Ccircle cx='10' cy='10' r='2'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E\");\n}\n.theme-neural-purple {\n  background: linear-gradient(\n    135deg,\n    #0f0f23 0%,\n    #1e1b4b 25%,\n    #581c87 50%,\n    #6b21a8 75%,\n    #1e1b4b 100%\n  );\n}\n.theme-neural-purple .quantum-card {\n  border-color: rgba(147, 51, 234, 0.3) !important;\n}\n.theme-neural-purple .holographic {\n  background: linear-gradient(45deg, #8b5cf6, #a855f7, #c084fc, #ddd6fe, #8b5cf6);\n  background-size: 400% 400%;\n}\n.theme-cyber-blue {\n  background: linear-gradient(\n    135deg,\n    #0c1445 0%,\n    #1e3a8a 25%,\n    #1d4ed8 50%,\n    #2563eb 75%,\n    #1e3a8a 100%\n  );\n}\n.theme-cyber-blue .quantum-card {\n  border-color: rgba(59, 130, 246, 0.3) !important;\n}\n.theme-cyber-blue .holographic {\n  background: linear-gradient(45deg, #3b82f6, #60a5fa, #93c5fd, #dbeafe, #3b82f6);\n  background-size: 400% 400%;\n}\n.theme-light {\n  background: linear-gradient(\n    135deg,\n    #f8fafc 0%,\n    #e2e8f0 25%,\n    #cbd5e1 50%,\n    #94a3b8 75%,\n    #f8fafc 100%\n  );\n  color: #1e293b !important;\n}\n.theme-light .quantum-card {\n  background: rgba(255, 255, 255, 0.8) !important;\n  border-color: rgba(0, 0, 0, 0.1) !important;\n  color: #1e293b !important;\n}\n.theme-light .ultra-glass {\n  background: rgba(255, 255, 255, 0.9) !important;\n  border-color: rgba(0, 0, 0, 0.1) !important;\n}\n.theme-light input,\n.theme-light select,\n.theme-light textarea {\n  color: #1e293b !important;\n  background: rgba(255, 255, 255, 0.9) !important;\n}\n.cyber-btn {\n  background: linear-gradient(45deg, #00ff88, #00d4ff);\n  border: none;\n  color: black;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 1px;\n  transition: all 0.3s ease;\n  position: relative;\n  overflow: hidden;\n}\n.cyber-btn::before {\n  content: '';\n  position: absolute;\n  top: 0;\n  left: -100%;\n  width: 100%;\n  height: 100%;\n  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);\n  transition: left 0.5s;\n}\n.cyber-btn:hover::before {\n  left: 100%;\n}\n.cyber-btn:hover {\n  box-shadow: 0 0 30px rgba(0, 255, 136, 0.6);\n  transform: translateY(-2px);\n}\n.nav-item {\n  transition: all 0.3s ease;\n  border-radius: 12px;\n  margin-bottom: 4px;\n}\n.nav-item:hover:not(.active) {\n  background: rgba(0, 255, 136, 0.1);\n  border: 1px solid rgba(0, 255, 136, 0.2);\n}\n.nav-item.active {\n  background: linear-gradient(135deg, rgba(6, 255, 165, 0.8), rgba(0, 255, 136, 0.6)) !important;\n  border: 1px solid rgba(6, 255, 165, 0.3) !important;\n  box-shadow: 0 4px 20px rgba(6, 255, 165, 0.4),\n    inset 0 1px 0 rgba(255, 255, 255, 0.1) !important;\n  backdrop-filter: blur(10px) !important;\n}\n.shadow-neon {\n  box-shadow: 0 0 20px rgba(0, 255, 136, 0.6),\n    0 0 40px rgba(0, 255, 136, 0.4);\n}\n.shadow-neon-pink {\n  box-s