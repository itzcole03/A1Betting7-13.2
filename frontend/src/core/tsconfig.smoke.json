{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2015", "DOM"]
  },
  // Limit the smoke check to the guarded-import shim and smoke tests only
  "include": [
    "./GuardedImport/**/*",
    "./TelemetryGate/**/*",
    "./UnifiedCache/**/*",
    "./UnifiedLogger/**/*",
    "./UnifiedMetrics.ts",
    "./tests/smoke/**/*.ts",
    "./tests/smoke/**/*.js"
  ]
}
