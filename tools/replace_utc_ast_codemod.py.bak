#!/usr/bin/env python3
"""
Safe, conservative codemod to replace datetime.utcnow() with
datetime.now(timezone.utc) across project files. This script:

- Operates only on provided targets (default: backend/ and scripts/)
- Skips venv/, .venv/, node_modules/, and third-party folders
- Performs a dry-run by default and shows diffs for files it would change
- Makes a .bak backup before writing when not in dry-run mode

Usage:
  python tools/replace_utc_ast_codemod.py --dry-run
  python tools/replace_utc_ast_codemod.py backend/core/response_models.py

This intentionally uses simple, well-scoped text transforms and only
modifies import lines that import from datetime when utcnow replacements
are present in the same file.
"""
from __future__ import annotations

import argparse
import difflib
import os
import re
from pathlib import Path
from typing import Iterable

EXCLUDE_DIRS = {"venv", ".venv", "node_modules", "site-packages"}


def iter_targets(paths: Iterable[str]) -> Iterable[Path]:
    for p in paths:
        path = Path(p)
        if path.is_file():
            yield path
        else:
            for root, dirs, files in os.walk(path):
                # prune excludes
                dirs[:] = [d for d in dirs if d not in EXCLUDE_DIRS]
                for f in files:
                    if f.endswith(".py"):
                        yield Path(root) / f


def should_process_text(text: str) -> bool:
    return "utcnow(" in text


def transform_text(text: str) -> str:
    orig = text

    # Prefer to replace the common pattern datetime.utcnow().isoformat() + "Z"
    # with a timezone-aware equivalent that yields a canonical Z suffix.
    text = re.sub(
        r"\bdatetime\.utcnow\(\)\.isoformat\(\)\s*\+\s*[\"']Z[\"']",
        'datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")',
        text,
    )

    # Replace standalone datetime.utcnow().isoformat() (no explicit +"Z")
    text = re.sub(
        r"\bdatetime\.utcnow\(\)\.isoformat\(\)",
        'datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")',
        text,
    )

    # Replace datetime.utcnow() -> datetime.now(timezone.utc) for other uses
    text = re.sub(r"\bdatetime\.utcnow\(\)", "datetime.now(timezone.utc)", text)

    # If we added datetime.now(timezone.utc) we may need to add timezone to imports
    if "datetime.now(timezone.utc)" in text and "from datetime import" in text:
        # Add timezone to from datetime import ... if missing
        def _add_timezone_to_imports(match: re.Match) -> str:
            items = [it.strip() for it in match.group(1).split(",")]
            if "timezone" not in items:
                items.append("timezone")
            return f"from datetime import {', '.join(items)}"

        text = re.sub(r"from datetime import ([^\n]+)", _add_timezone_to_imports, text)

    return text


def apply_to_file(path: Path, dry_run: bool = True) -> bool:
    text = path.read_text(encoding="utf-8")
    if not should_process_text(text):
        return False

    new_text = transform_text(text)
    if new_text == text:
        return False

    if dry_run:
        print(f"--- DRY-RUN: {path}")
        for ln in difflib.unified_diff(
            text.splitlines(),
            new_text.splitlines(),
            lineterm="",
            fromfile=str(path),
            tofile=str(path) + ".new",
        ):
            print(ln)
        return True

    # backup then write
    bak = path.with_suffix(path.suffix + ".bak")
    bak.write_text(text, encoding="utf-8")
    path.write_text(new_text, encoding="utf-8")
    print(f"Patched {path} (backup: {bak})")
    return True


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "paths",
        nargs="*",
        default=["backend", "scripts"],
        help="Files or directories to process",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        default=True,
        dest="dry_run",
        help="Show diffs but don't write files (default: true)",
    )
    parser.add_argument(
        "--apply",
        action="store_false",
        dest="dry_run",
        help="Apply changes (writes files, create .bak backups)",
    )

    args = parser.parse_args()

    processed = 0
    changed = 0
    for p in iter_targets(args.paths):
        try:
            processed += 1
            if apply_to_file(p, dry_run=args.dry_run):
                changed += 1
        except Exception as e:
            print(f"ERROR processing {p}: {e}")

    print(f"Processed {processed} files, {changed} would be/was changed.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
