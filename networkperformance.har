            "mimeType": "text/javascript",
            "text": "const DEFAULT_CONFIG = {\n  showPositiveSign: true,\n  showPercentSymbol: true,\n  decimalPlaces: 1,\n  colorScale: {\n    excellent: 8,\n    good: 4,\n    neutral: 0\n  }\n};\nexport function formatEvPercent(evPercent, config = {}) {\n  const cfg = { ...DEFAULT_CONFIG, ...config };\n  if (evPercent === null || evPercent === void 0 || !Number.isFinite(evPercent)) {\n    return \"--\";\n  }\n  const formatted = evPercent.toFixed(cfg.decimalPlaces);\n  const sign = evPercent > 0 && cfg.showPositiveSign ? \"+\" : \"\";\n  const percent = cfg.showPercentSymbol ? \"%\" : \"\";\n  return `${sign}${formatted}${percent}`;\n}\nexport function getEvColorClass(evPercent, config = {}) {\n  const cfg = { ...DEFAULT_CONFIG, ...config };\n  if (evPercent === null || evPercent === void 0 || !Number.isFinite(evPercent)) {\n    return \"text-gray-400\";\n  }\n  if (evPercent >= cfg.colorScale.excellent) {\n    return \"text-green-400\";\n  } else if (evPercent >= cfg.colorScale.good) {\n    return \"text-amber-400\";\n  } else if (evPercent >= cfg.colorScale.neutral) {\n    return \"text-yellow-400\";\n  } else {\n    return \"text-gray-500\";\n  }\n}\nexport function getEvBadgeColorClass(evPercent, config = {}) {\n  const cfg = { ...DEFAULT_CONFIG, ...config };\n  if (evPercent === null || evPercent === void 0 || !Number.isFinite(evPercent)) {\n    return \"bg-gray-600\";\n  }\n  if (evPercent >= cfg.colorScale.excellent) {\n    return \"bg-green-600\";\n  } else if (evPercent >= cfg.colorScale.good) {\n    return \"bg-amber-600\";\n  } else {\n    return \"bg-gray-600\";\n  }\n}\nexport function shouldShowEvBadge(evPercent, minThreshold = 4) {\n  if (evPercent === null || evPercent === void 0 || !Number.isFinite(evPercent)) {\n    return false;\n  }\n  return evPercent >= minThreshold;\n}\nexport function formatEvValue(evValue, decimalPlaces = 2) {\n  if (evValue === null || evValue === void 0 || !Number.isFinite(evValue)) {\n    return \"--\";\n  }\n  const abs = Math.abs(evValue);\n  const sign = evValue > 0 ? \"+\" : evValue < 0 ? \"-\" : \"\";\n  return `${sign}$${abs.toFixed(decimalPlaces)}`;\n}\nexport function createEvTooltip(evPercent, evValue) {\n  if (evPercent === null || evPercent === void 0 || !Number.isFinite(evPercent)) {\n    return \"Expected Value not calculated\";\n  }\n  const formattedPercent = formatEvPercent(evPercent);\n  let tooltip = `Expected Value: ${formattedPercent}`;\n  if (evValue !== null && evValue !== void 0 && Number.isFinite(evValue)) {\n    const formattedValue = formatEvValue(evValue);\n    tooltip += ` (${formattedValue} per bet)`;\n  }\n  if (evPercent > 0) {\n    tooltip += \"\\nPositive EV indicates expected profit\";\n  } else if (evPercent < 0) {\n    tooltip += \"\\nNegative EV indicates expected loss\";\n  } else {\n    tooltip += \"\\nBreakeven expected value\";\n  }\n  return tooltip;\n}\nexport function getEvDisplayPriority(evPercent, isOutlier) {\n  let priority = 0;\n  if (evPercent !== null && evPercent !== void 0 && Number.isFinite(evPercent)) {\n    priority += Math.max(0, evPercent);\n  }\n  if (isOutlier) {\n    priority += 10;\n  }\n  return priority;\n}\nexport function isValuePlay(evPercent, isOutlier, customThreshold = 5) {\n  if (isOutlier) {\n    return true;\n  }\n  if (evPercent !== null && evPercent !== void 0 && Number.isFinite(evPercent)) {\n    return evPercent >= customThreshold;\n  }\n  return false;\n}\nexport function classifyEvPillTier(evPercent) {\n  if (evPercent === null || evPercent === void 0 || !Number.isFinite(evPercent)) {\n    return \"gray\";\n  }\n  if (evPercent >= 7) return \"green\";\n  if (evPercent >= 4) return \"orange\";\n  if (evPercent >= 2) return \"yellow\";\n  return \"gray\";\n}\nexport function getEvPillClasses(evPercent) {\n  const tier = classifyEvPillTier(evPercent);\n  switch (tier) {\n    case \"green\":\n      return { bg: \"bg-green-600\", text: \"text-white\", label: \"EV +\" };\n    case \"orange\":\n      return { bg: \"bg-orange-500\", text: \"text-white\", label: \"EV\" };\n    case \"yellow\":\n      return { bg: \"bg-yellow-500\", text: \"text-black\", label: \"EV\" };\n    case \"gray\":\n    default:\n      return { bg: \"bg-gray-600\", text: \"text-white\", label: \"EV\" };\n  }\n}\n\n//# sourceMappingURL=data:application/json;base64,"
