            "text": "export function formatClvPercent(value) {\n  if (value === null || value === void 0 || isNaN(value)) {\n    return \"--\";\n  }\n  const decimals = Math.abs(value) >= 10 ? 0 : 2;\n  return `${value.toFixed(decimals)}%`;\n}\nexport function clvColor(value) {\n  if (value === null || value === void 0 || isNaN(value)) {\n    return \"#6b7280\";\n  }\n  if (value >= 5) {\n    return \"#10b981\";\n  }\n  if (value >= 1) {\n    return \"#f59e0b\";\n  }\n  if (value > -1) {\n    return \"#9ca3af\";\n  }\n  return \"#ef4444\";\n}\nexport function clvBadgeClasses(value) {\n  const bgColor = clvColor(value);\n  return {\n    backgroundColor: bgColor,\n    color: \"#ffffff\",\n    // Always white text for better contrast\n    borderColor: bgColor\n  };\n}\nexport function clvDescription(value) {\n  if (value === null || value === void 0 || isNaN(value)) {\n    return \"No Data\";\n  }\n  if (value >= 5) return \"Excellent\";\n  if (value >= 1) return \"Good\";\n  if (value >= -1) return \"Fair\";\n  return \"Poor\";\n}\nexport function clvTooltip(value) {\n  const baseExplanation = \"CLV = (Closing Line - Opening Line) / Opening Line × 100\";\n  if (value === null || value === void 0 || isNaN(value)) {\n    return `${baseExplanation}. No closing line data available.`;\n  }\n  const formattedValue = formatClvPercent(value);\n  const description = clvDescription(value);\n  return `${baseExplanation}. Current CLV: ${formattedValue} (${description})`;\n}\nexport function sortByClv(a, b, descending = true) {\n  if ((a === null || a === void 0) && (b === null || b === void 0)) return 0;\n  if (a === null || a === void 0) return 1;\n  if (b === null || b === void 0) return -1;\n  const diff = a - b;\n  return descending ? -diff : diff;\n}\nexport function hasClvData(opportunity) {\n  return opportunity.clvPercent !== null && opportunity.clvPercent !== void 0 && !isNaN(opportunity.clvPercent);\n}\nexport const CLV_BANDS = {\n  EXCELLENT: { min: 5, label: \"Excelle