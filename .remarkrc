{
  "plugins": [
    "remark-preset-lint-recommended",
    ["remark-lint-ordered-list-marker-value", "one"],
    ["remark-lint-maximum-line-length", { "code": 0, "ignore": ["http", "https"], "max": 140 }],
    ["remark-lint-heading-increment", true],
    ["remark-lint-fenced-code-flag", true],
    ["remark-lint-no-dead-urls", false]
  ]
}
