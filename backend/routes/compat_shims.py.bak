from fastapi import APIRouter, Request
from fastapi.responses import JSONResponse
from backend.utils.response_envelope import ok

router = APIRouter()


@router.get("/simple-test")
async def compat_simple_test():
    # Lightweight compatibility shim for legacy tests that call /simple-test
    return ok([{"message": "Compatibility simple-test: use /v1/simple-test or /api/docs"}])


@router.get("/bankroll/status")
async def compat_bankroll_status():
    # Forward to canonical /api/bankroll/status consumer shape by returning a compatible payload
    return ok({"status": "ready", "details": "Bankroll service available (compat shim)"})


@router.get("/user/profile")
async def compat_user_profile():
    # Tests that hit /user/profile during unit tests expect a JSON 404 or profile detail; return NotFound-like envelope
    return JSONResponse(status_code=404, content={"success": False, "data": None, "error": {"code": "E4040_NOT_FOUND", "message": "Not Found"}})


@router.post("/predict")
@router.get("/predict")
async def compat_predict():
    # Simple shim: route exists so tests asserting 404 vs 200 will find a handler.
    return JSONResponse(status_code=404, content={"success": False, "data": None, "error": {"code": "E4040_NOT_FOUND", "message": "Predict endpoint is under /api/v2/models/predict"}})
