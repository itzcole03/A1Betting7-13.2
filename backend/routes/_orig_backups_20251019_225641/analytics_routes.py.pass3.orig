"""
Analytics API Routes

Provides endpoints for EV and arbitrage analytics data, including:
- Daily aggregation statistics
- Historical trend analysis
- Consolidated dashboard summary
- Manual data retention pruning
"""

import logging
from datetime import datetime, timezone
from typing import Any, Dict, List
from backend.core.exceptions import BusinessLogicException

from fastapi import APIRouter, Depends, HTTPException, Query
from pydantic import BaseModel, Field
from backend.database import get_async_session
from backend.services.analytics_persistence_service import (
    AnalyticsPersistenceService,
    DailyArbitrageStats,
    DailyEVStats,
)

logger = logging.getLogger(__name__)
router = APIRouter(prefix="/api/analytics", tags=["analytics"])


# Response models
class DailyEVStatsResponse(BaseModel):
    """Response model for daily EV statistics"""

    date: str
    total_opportunities: int
    avg_ev_percent: float = Field(..., description="Average EV percentage")
    tier_counts: Dict[str, int] = Field(
        ..., description="Count by tier (low, medium, high, premium)"
    )
    top_sports: List[Dict[str, Any]] = Field(
        ..., description="Top sports by opportunity count"
    )
    top_players: List[Dict[str, Any]] = Field(
        ..., description="Top players by opportunity count"
    )


class DailyArbitrageStatsResponse(BaseModel):
    """Response model for daily arbitrage statistics"""

    date: str
    total_opportunities: int
    avg_profit_pct: float = Field(..., description="Average profit percentage")
    total_books_involved: int = Field(..., description="Total bookmakers involved")
    top_sports: List[Dict[str, Any]] = Field(
        ..., description="Top sports by opportunity count"
    )
    top_markets: List[Dict[str, Any]] = Field(
        ..., description="Top markets by opportunity count"
    )


class AnalyticsSummaryResponse(BaseModel):
    """Response model for consolidated analytics summary"""

    class EVSummary(BaseModel):
        avg: float = Field(..., description="Average EV percentage (24h)")
        pctHigh: float = Field(..., description="Percentage of opportunities >= 7% EV")
        tierCounts: Dict[str, int] = Field(..., description="Count by tier")

    class ArbitrageSummary(BaseModel):
        count24h: int = Field(..., description="Total arbitrage opportunities in 24h")
        avgProfitPct24h: float = Field(
            ..., description="Average profit percentage (24h)"
        )

    ev: EVSummary
    arbitrage: ArbitrageSummary


class PruneResponse(BaseModel):
    """Response model for data retention pruning"""

    ev_opportunities_deleted: int
    arbitrage_opportunities_deleted: int
    pruned_at: str


# Dependency injection
async def get_analytics_service(
    session_factory=Depends(get_async_session),
) -> AnalyticsPersistenceService:
    """Get analytics persistence service with async session factory"""
    return AnalyticsPersistenceService(session_factory)


@router.get("/daily-ev-stats", response_model=List[DailyEVStatsResponse])
async def get_daily_ev_stats(
    days: int = Query(30, ge=1, le=365, description="Number of days to retrieve"),
    analytics_service: AnalyticsPersistenceService = Depends(get_analytics_service),
):
    """
    Get daily EV opportunity statistics for the specified number of days.

    Returns aggregated statistics including:
    - Total opportunities per day
    - Average EV percentage
    - Distribution by tier (low, medium, high, premium)
    - Top sports and players by volume
    """
    try:
        logger.info(f"Fetching daily EV stats for {days} days")

        stats = await analytics_service.get_daily_ev_stats(days)

        # Convert to response models
        return [
            DailyEVStatsResponse(
                date=stat.date,
                total_opportunities=stat.total_opportunities,
                avg_ev_percent=stat.avg_ev_percent,
                tier_counts=stat.tier_counts,
                top_sports=stat.top_sports,
                top_players=stat.top_players,
            )
            for stat in stats
        ]

    except Exception as e:
        logger.error(f"Failed to get daily EV stats: {e}", exc_info=True)
        raise BusinessLogicException(
            "Failed to retrieve EV statistics", status_code=500
        )


@router.get("/daily-arb-stats", response_model=List[DailyArbitrageStatsResponse])
async def get_daily_arbitrage_stats(
    days: int = Query(30, ge=1, le=365, description="Number of days to retrieve"),
    analytics_service: AnalyticsPersistenceService = Depends(get_analytics_service),
):
    """
    Get daily arbitrage opportunity statistics for the specified number of days.

    Returns aggregated statistics including:
    - Total arbitrage opportunities per day
    - Average profit percentage
    - Total bookmakers involved
    - Top sports and markets by volume
    """
    try:
        logger.info(f"Fetching daily arbitrage stats for {days} days")

        stats = await analytics_service.get_daily_arbitrage_stats(days)

        # Convert to response models
        return [
            DailyArbitrageStatsResponse(
                date=stat.date,
                total_opportunities=stat.total_opportunities,
                avg_profit_pct=stat.avg_profit_pct,
                total_books_involved=stat.total_books_involved,
                top_sports=stat.top_sports,
                top_markets=stat.top_markets,
            )
            for stat in stats
        ]

    except Exception as e:
        logger.error(f"Failed to get daily arbitrage stats: {e}", exc_info=True)
        raise BusinessLogicException(
            "Failed to retrieve arbitrage statistics", status_code=500
        )


@router.get("/summary", response_model=AnalyticsSummaryResponse)
async def get_analytics_summary(
    analytics_service: AnalyticsPersistenceService = Depends(get_analytics_service),
):
    """
    Get consolidated analytics summary for dashboard display.

    Returns 24-hour summary statistics including:
    - EV: Average EV%, percentage of high-value opportunities, tier distribution
    - Arbitrage: Total opportunities and average profit percentage
    """
    try:
        logger.info("Fetching analytics summary")

        summary = await analytics_service.get_summary_stats()

        return AnalyticsSummaryResponse(
            ev=AnalyticsSummaryResponse.EVSummary(
                avg=summary["ev"]["avg"],
                pctHigh=summary["ev"]["pctHigh"],
                tierCounts=summary["ev"]["tierCounts"],
            ),
            arbitrage=AnalyticsSummaryResponse.ArbitrageSummary(
                count24h=summary["arbitrage"]["count24h"],
                avgProfitPct24h=summary["arbitrage"]["avgProfitPct24h"],
            ),
        )

    except Exception as e:
        logger.error(f"Failed to get analytics summary: {e}", exc_info=True)
        raise BusinessLogicException(
            "Failed to retrieve analytics summary", status_code=500
        )


@router.post("/prune", response_model=PruneResponse)
async def prune_old_records(
    analytics_service: AnalyticsPersistenceService = Depends(get_analytics_service),
):
    """
    Manually trigger pruning of old records based on retention configuration.

    Removes records older than:
    - EV_HISTORY_RETENTION_DAYS for EV opportunities (default: 90 days)
    - ARB_HISTORY_RETENTION_DAYS for arbitrage opportunities (default: 90 days)

    This endpoint is typically called by scheduled background jobs but can be
    triggered manually for maintenance purposes.
    """
    try:
        logger.info("Manual pruning of old analytics records triggered")

        results = await analytics_service.prune_old_records()

        return PruneResponse(
            ev_opportunities_deleted=results["ev_opportunities_deleted"],
            arbitrage_opportunities_deleted=results["arbitrage_opportunities_deleted"],
            pruned_at=datetime.now(timezone.utc).isoformat(),
        )

    except Exception as e:
        logger.error(f"Failed to prune old records: {e}", exc_info=True)
        raise BusinessLogicException("Failed to prune old records", status_code=500)


@router.get("/health")
async def health_check():
    """
    Health check endpoint for analytics service.

    Returns basic service status and configuration.
    """
    return {
        "status": "healthy",
        "service": "analytics_persistence",
        "retention_config": {
            "ev_history_retention_days": 90,  # Could read from service config
            "arb_history_retention_days": 90,
        },
        "thresholds": {"ev_min_threshold": 3.0, "arb_min_profit_pct": 1.0},
        "timestamp": datetime.now(timezone.utc).isoformat(),
    }
