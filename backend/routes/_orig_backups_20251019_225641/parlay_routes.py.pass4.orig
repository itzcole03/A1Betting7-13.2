"""
Parlay Analytics API Routes

FastAPI routes for parlay betting analytics:
- POST /api/parlay/analyze - Comprehensive parlay analysis
- GET /api/parlay/health - Service health check
- Comprehensive error handling and validation

Author: A1Betting Parlay Analytics System
"""

import logging
from datetime import datetime
from typing import List, Dict, Any
from fastapi import APIRouter, HTTPException, status, Request
from fastapi.responses import JSONResponse
from backend.core.exceptions import BusinessLogicException

from ..models.parlay_models import (
    ParlayAnalysisRequest,
    ParlayAnalysisApiResponse,
    ParlayAnalyticsResponse,
    ParlayAnalysisErrorResponse,
    ParlayHealthApiResponse,
    ParlayHealthResponse,
    CorrelationWarningResponse,
    IndividualLegAnalysis,
    CorrelationLevel as ModelCorrelationLevel
)
from ..services.parlay_calculator import parlay_calculator, ParlayLeg, CorrelationLevel as ServiceCorrelationLevel

logger = logging.getLogger("propollama")
router = APIRouter(prefix="/api/parlay", tags=["parlay"])


@router.get("/health")
async def parlay_health_check() -> ParlayHealthApiResponse:
    """
    Health check endpoint for parlay analytics service
    """
    try:
        # Check if calculator is properly initialized
        calculator_ready = hasattr(parlay_calculator, 'correlation_patterns')
        correlation_patterns_loaded = bool(
            calculator_ready and 
            parlay_calculator.correlation_patterns
        )
        
        health_data = ParlayHealthResponse(
            status="healthy",
            calculator_ready=calculator_ready,
            correlation_patterns_loaded=correlation_patterns_loaded,
            timestamp=datetime.utcnow().isoformat()
        )
        
        return ParlayHealthApiResponse(
            success=True,
            data=health_data,
            message="Parlay analytics service is healthy"
        )
        
    except Exception as e:
        logger.error(f"Parlay health check failed: {e})
        return ParlayHealthApiResponse(
            success=False,
            data=None,
            message=f"Parlay service health check failed: {str(e)
        )


@router.post("/analyze")
async def analyze_parlay(
    request: ParlayAnalysisRequest
) -> ParlayAnalysisApiResponse:
    """
    Analyze a parlay for EV, correlations, and risk assessment
    
    Args:
        request: Parlay analysis request with legs data
        
    Returns:
        Comprehensive parlay analytics including:
        - Total payout calculation
        - Expected value analysis
        - Correlation warnings
        - Risk assessment
        - Individual leg analysis
    """
    try:
        # Validate minimum number of legs
        if not request.legs or len(request.legs) < 2:
            raise BusinessLogicException(
                status_code=status.HTTP_400_BAD_REQUEST,
                detail="Parlay must have at least 2 legs"
            )
        
        # Validate maximum number of legs (reasonable limit)
        if len(request.legs) > 15:
            raise BusinessLogicException(
                status_code=status.HTTP_400_BAD_REQUEST,
                detail="Parlay cannot have more than 15 legs"
            )
        
        logger.info(f"Analyzing parlay with {len(request.legs)} legs")
        
        # Convert request models to internal ParlayLeg objects
        parlay_legs = []
        for leg_request in request.legs:
            parlay_leg = ParlayLeg(
                player=leg_request.player,
                market=leg_request.market,
                odds=leg_request.odds,
                our_fair_odds=leg_request.our_fair_odds,
                team=leg_request.team,
                stat_type=leg_request.stat_type
            )
            parlay_legs.append(parlay_leg)
        
        # Perform parlay analysis
        analytics = parlay_calculator.analyze_parlay(parlay_legs)
        
        # Calculate raw EV before correlation adjustment
        market_odds = [leg.odds for leg in parlay_legs]
        fair_odds = [leg.our_fair_odds for leg in parlay_legs]
        _, _, raw_ev = parlay_calculator.compute_conditional_ev(fair_odds, market_odds)
        
        # Calculate correlation adjustment factor
        correlation_adjustment = 1.0
        for warning in analytics.correlation_warnings:
            correlation_adjustment *= warning.risk_factor
        
        # Convert internal response to API response models
        correlation_warnings_response = []
        for warning in analytics.correlation_warnings:
            # Convert service enum to model enum
            model_level = ModelCorrelationLevel(warning.level.value)
            correlation_warnings_response.append(
                CorrelationWarningResponse(
                    level=model_level,
                    message=warning.message,
                    affected_legs=warning.affected_legs,
                    risk_factor=warning.risk_factor
                )
            )
        
        individual_leg_analysis_response = []
        for leg_analysis in analytics.individual_leg_analysis:
            individual_leg_analysis_response.append(
                IndividualLegAnalysis(
                    leg_index=leg_analysis["leg_index"],
                    player=leg_analysis["player"],
                    market=leg_analysis["market"],
                    odds=leg_analysis["odds"],
                    implied_probability=leg_analysis["implied_probability"],
                    fair_probability=leg_analysis["fair_probability"],
                    individual_ev=leg_analysis["individual_ev"]
                )
            )
        
        # Create comprehensive response
        analytics_response = ParlayAnalyticsResponse(
            total_payout=analytics.total_payout,
            implied_probability=analytics.implied_probability,
            fair_probability=analytics.fair_probability,
            expected_value_percent=analytics.expected_value_percent,
            raw_expected_value_percent=raw_ev,
            correlation_warnings=correlation_warnings_response,
            risk_assessment=analytics.risk_assessment,
            individual_leg_analysis=individual_leg_analysis_response,
            number_of_legs=len(parlay_legs),
            correlation_adjustment_factor=correlation_adjustment
        )
        
        # Log analysis results
        logger.info(f"Parlay analysis completed: EV={analytics.expected_value_percent:.2f}%, "
                   f"Payout={analytics.total_payout:.2f}x, "
                   f"Warnings={len(analytics.correlation_warnings)}, "
                   f"Risk={analytics.risk_assessment})
        
        return ParlayAnalysisApiResponse(
            success=True,
            data=analytics_response,
            error=None,
            message=f"Successfully analyzed {len(parlay_legs)}-leg parlay"
        )
        
    except ValueError as ve:
        # Handle validation errors
        logger.warning(f"Parlay analysis validation error: {ve})
        
        error_response = ParlayAnalysisErrorResponse(
            error=str(ve),
            error_code="VALIDATION_ERROR",
            details={"request_legs": len(request.legs) if request.legs else 0}
        )
        
        return ParlayAnalysisApiResponse(
            success=False,
            data=None,
            error=error_response,
            message="Invalid parlay data provided"
        )
        
    except Exception as e:
        # Handle unexpected errors
        logger.error(f"Parlay analysis failed: {e}, exc_info=True)
        
        error_response = ParlayAnalysisErrorResponse(
            error="Internal server error during parlay analysis",
            error_code="INTERNAL_ERROR",
            details={"original_error": str(e)
        )
        
        return ParlayAnalysisApiResponse(
            success=False,
            data=None,
            error=error_response,
            message="Failed to analyze parlay due to internal error"
        )


@router.get("/correlation-patterns")
async def get_correlation_patterns() -> Dict[str, Any]:
    """
    Get available correlation patterns for educational purposes
    """
    try:
        patterns = parlay_calculator.correlation_patterns
        
        return {
            "success": True,
            "data": {
                "patterns": patterns,
                "pattern_count": len(patterns),
                "description": "Known correlation patterns used for parlay analysis"
            },
            "message": "Successfully retrieved correlation patterns"
        }
        
    except Exception as e:
        logger.error(f"Failed to get correlation patterns: {e})
        return {
            "success": False,
            "error": str(e),
            "message": "Failed to retrieve correlation patterns"
        }


@router.post("/simulate")
async def simulate_parlay_outcomes(
    request: ParlayAnalysisRequest,
    simulations: int = 10000
) -> Dict[str, Any]:
    """
    Simulate parlay outcomes for Monte Carlo analysis
    
    Args:
        request: Parlay to simulate
        simulations: Number of simulations to run (default 10,000)
        
    Returns:
        Simulation results with win probability and payout distribution
    """
    try:
        if simulations > 100000:
            raise ValueError("Maximum 100,000 simulations allowed")
        
        logger.info(f"Running {simulations} parlay simulations")
        
        # Convert to internal format
        parlay_legs = []
        for leg_request in request.legs:
            parlay_leg = ParlayLeg(
                player=leg_request.player,
                market=leg_request.market,
                odds=leg_request.odds,
                our_fair_odds=leg_request.our_fair_odds,
                team=leg_request.team,
                stat_type=leg_request.stat_type
            )
            parlay_legs.append(parlay_leg)
        
        # Get basic analytics
        analytics = parlay_calculator.analyze_parlay(parlay_legs)
        
        # Simple simulation logic
        import random
        wins = 0
        total_payout = 0
        
        fair_probs = []
        for leg in parlay_legs:
            fair_decimal = parlay_calculator.american_to_decimal(leg.our_fair_odds)
            fair_prob = parlay_calculator.decimal_to_implied_probability(fair_decimal)
            fair_probs.append(fair_prob)
        
        for _ in range(simulations):
            # Simulate each leg
            all_legs_hit = True
            for prob in fair_probs:
                if random.random() > prob:
                    all_legs_hit = False
                    break
            
            if all_legs_hit:
                wins += 1
                total_payout += analytics.total_payout
        
        win_percentage = (wins / simulations) * 100
        average_payout = total_payout / simulations if simulations > 0 else 0
        
        return {
            "success": True,
            "data": {
                "simulations_run": simulations,
                "wins": wins,
                "win_percentage": win_percentage,
                "theoretical_win_percentage": analytics.fair_probability * 100,
                "average_payout_per_simulation": average_payout,
                "total_simulated_payout": total_payout,
                "break_even_win_rate": (1 / analytics.total_payout) * 100
            },
            "message": f"Completed {simulations} parlay simulations"
        }
        
    except Exception as e:
        logger.error(f"Parlay simulation failed: {e})
        return {
            "success": False,
            "error": str(e),
            "message": "Failed to simulate parlay outcomes"
        }