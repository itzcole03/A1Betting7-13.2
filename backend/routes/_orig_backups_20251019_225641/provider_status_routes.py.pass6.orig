"""
Enhanced Odds Provider Status API Routes

Provides comprehensive API endpoints for monitoring provider health, statistics,
and status using the enhanced provider statistics system integrated with the
existing ProviderResilienceManager.
""""

from fastapi import APIRouter, HTTPException, Query, Depends
from typing import Dict, List, Optional, Any, Tuple
from pydantic import BaseModel, Field
import logging
from backend.core.exceptions import BusinessLogicException

from ..services.provider_statistics_integration import provider_statistics_integration
# Response Models
class ProviderLatencyPercentiles(BaseModel):
    p50: float = Field(description="50th percentile latency in ms")
    p95: float = Field(description="95th percentile latency in ms") 
    p99: float = Field(description="99th percentile latency in ms")


class ProviderSuccessRates(BaseModel):
    window_1m: float = Field(alias="1m", description="Success rate over 1 minute")
    window_5m: float = Field(alias="5m", description="Success rate over 5 minutes")
    window_15m: float = Field(alias="15m", description="Success rate over 15 minutes")
    window_1h: float = Field(alias="1h", description="Success rate over 1 hour")


class ProviderLatencyMetrics(BaseModel):
    window_1m: ProviderLatencyPercentiles = Field(alias="1m")
    window_5m: ProviderLatencyPercentiles = Field(alias="5m")
    window_15m: ProviderLatencyPercentiles = Field(alias="15m")
    window_1h: ProviderLatencyPercentiles = Field(alias="1h")


class ProviderRequestRates(BaseModel):
    window_1m: float = Field(alias="1m", description="Requests per minute over 1 minute")
    window_5m: float = Field(alias="5m", description="Requests per minute over 5 minutes")
    window_15m: float = Field(alias="15m", description="Requests per minute over 15 minutes")
    window_1h: float = Field(alias="1h", description="Requests per minute over 1 hour")


class ProviderTrends(BaseModel):
    success_rate_trend: str = Field(description="Success rate trend: improving, stable, degrading")
    latency_trend: str = Field(description="Latency trend: improving, stable, degrading")


class ProviderHealthResponse(BaseModel):
    provider_id: str
    
    # Circuit breaker and resilience state
    consecutive_failures: int
    circuit_state: str = Field(description="Circuit breaker state: closed, half_open, open")
    provider_state: str = Field(description="Provider state: healthy, degraded, failing, circuit_open")
    can_retry: bool
    retry_after_sec: float
    
    # Enhanced statistics
    confidence_score: float = Field(ge=0.0, le=1.0, description="Overall confidence score 0-1")
    success_rates: ProviderSuccessRates
    latency_percentiles: ProviderLatencyMetrics
    request_rates_per_min: ProviderRequestRates
    trends: ProviderTrends
    data_freshness_score: float = Field(ge=0.0, le=1.0, description="Data freshness score 0-1")
    
    # Unified health assessment
    overall_health_status: str = Field(description="Overall health: excellent, good, degraded, failing, outage")
    is_recommended: bool = Field(description="Whether provider is recommended for use")
    priority_rank: int = Field(description="Priority ranking (lower = higher priority)")
    
    class Config:
        allow_population_by_field_name = True


class SystemHealthSummary(BaseModel):
    total_providers: int
    recommended_providers: int
    system_health_score: float = Field(ge=0.0, le=1.0)
    average_confidence: float = Field(ge=0.0, le=1.0)


class ProviderDistribution(BaseModel):
    excellent: int
    good: int
    degraded: int
    failing: int
    outage: int


class TopProvider(BaseModel):
    provider_id: str
    confidence_score: float
    health_status: str
    priority_rank: int


class SystemIssuesSummary(BaseModel):
    total_issues: int
    by_category: Dict[str, int]
    details: Dict[str, List[Dict[str, Any]]]


class SystemHealthDashboardResponse(BaseModel):
    system_overview: SystemHealthSummary
    provider_distribution: ProviderDistribution
    top_providers: List[TopProvider]
    system_issues: SystemIssuesSummary


class ProviderStatisticsResponse(BaseModel):
    provider_id: str
    confidence_score: float
    data_freshness_score: float
    overall_success_rate: float
    uptime_hours: float
    success_rates: ProviderSuccessRates
    latency_percentiles: ProviderLatencyMetrics
    request_rates_per_min: ProviderRequestRates
    trends: ProviderTrends
    total_requests: int
    total_successes: int
    last_request_age_sec: Optional[float]


class ConfidenceScoreResponse(BaseModel):
    provider_scores: Dict[str, float] = Field(description="Provider ID to confidence score mapping")
    top_providers: List[Tuple[str, float]] = Field(description="Top providers by confidence score")


# Router setup
router = APIRouter(prefix="/api/odds/providers", tags=["Provider Status"])
logger = logging.getLogger("provider_status_api")


def transform_latency_percentiles(latency_data: Dict[str, Dict[str, float]]) -> ProviderLatencyMetrics:
    """Transform latency percentiles data to the correct format"""
    return ProviderLatencyMetrics(
        **{
            "1m": ProviderLatencyPercentiles(**latency_data["1m"]),
            "5m": ProviderLatencyPercentiles(**latency_data["5m"]),
            "15m": ProviderLatencyPercentiles(**latency_data["15m"]),
            "1h": ProviderLatencyPercentiles(**latency_data["1h"]),
        }
    )


async def ensure_integration_started():
    """Dependency to ensure integration is started"""
    if not provider_statistics_integration._integration_started:
        await provider_statistics_integration.start_integration()


@router.get("/status", response_model=List[ProviderHealthResponse])
async def get_all_provider_status(
    recommended_only: bool = Query(False, description="Return only recommended providers"),
    limit: Optional[int] = Query(None, description="Limit number of providers returned"),
    _: None = Depends(ensure_integration_started)
):
    """
    Get comprehensive status for all providers including rolling window statistics,
    confidence scores, circuit breaker states, and health assessments.
    """"
    try:
        if recommended_only:
            provider_health_list = await provider_statistics_integration.get_recommended_providers(
                limit=limit or 10
            )
        else:
            provider_health_list = await provider_statistics_integration.get_all_provider_health()
            if limit:
                provider_health_list = provider_health_list[:limit]
        
        response = []
        for health in provider_health_list:
            response.append(ProviderHealthResponse(
                provider_id=health.provider_id,
                consecutive_failures=health.consecutive_failures,
                circuit_state=health.circuit_state,
                provider_state=health.provider_state,
                can_retry=health.can_retry,
                retry_after_sec=health.retry_after_sec,
                confidence_score=health.confidence_score,
                success_rates=ProviderSuccessRates(**health.success_rates),
                latency_percentiles=transform_latency_percentiles(health.latency_percentiles),
                request_rates_per_min=ProviderRequestRates(**health.request_rates_per_min),
                trends=ProviderTrends(**health.trends),
                data_freshness_score=health.data_freshness_score,
                overall_health_status=health.overall_health_status,
                is_recommended=health.is_recommended,
                priority_rank=health.priority_rank,
            ))
        
        logger.info("Provider status retrieved", extra={
            "category": "provider_status_api",
            "action": "get_all_status",
            "provider_count": len(response),
            "recommended_only": recommended_only,
            "limit": limit,
        })
        
        return response
        
    except Exception as e:
        logger.error("Failed to get provider status", extra={
            "category": "provider_status_api",
            "action": "get_all_status_error",
            "error": str(e),
        })
        raise BusinessLogicException(f"Failed to retrieve provider status: {str(e)}, status_code=500)")


@router.get("/status/{provider_id}, response_model=ProviderHealthResponse)"
async def get_provider_status(
    provider_id: str,
    _: None = Depends(ensure_integration_started)
):
    """
    Get detailed status for a specific provider including all rolling window
    statistics, confidence scoring, and health assessment.
    """"
    try:
        health = await provider_statistics_integration.get_unified_provider_health(provider_id)
        
        if not health:
            raise BusinessLogicException(f"Provider {provider_id} not found", status_code=404)
        
        response = ProviderHealthResponse(
            provider_id=health.provider_id,
            consecutive_failures=health.consecutive_failures,
            circuit_state=health.circuit_state,
            provider_state=health.provider_state,
            can_retry=health.can_retry,
            retry_after_sec=health.retry_after_sec,
            confidence_score=health.confidence_score,
            success_rates=ProviderSuccessRates(**health.success_rates),
            latency_percentiles=transform_latency_percentiles(health.latency_percentiles),
            request_rates_per_min=ProviderRequestRates(**health.request_rates_per_min),
            trends=ProviderTrends(**health.trends),
            data_freshness_score=health.data_freshness_score,
            overall_health_status=health.overall_health_status,
            is_recommended=health.is_recommended,
            priority_rank=health.priority_rank,
        )
        
        logger.info("Provider status retrieved", extra={
            "category": "provider_status_api",
            "action": "get_provider_status",
            "provider_id": provider_id,
            "health_status": health.overall_health_status,
            "confidence_score": health.confidence_score,
        })
        
        return response
        
    except HTTPException:
        raise
    except Exception as e:
        logger.error("Failed to get provider status", extra={
            "category": "provider_status_api",
            "action": "get_provider_status_error",
            "provider_id": provider_id,
            "error": str(e),
        })
        raise BusinessLogicException(f"Failed to retrieve provider status: {str(e)}, status_code=500)")


@router.get("/statistics/{provider_id}, response_model=ProviderStatisticsResponse)"
async def get_provider_statistics(
    provider_id: str,
    _: None = Depends(ensure_integration_started)
):
    """
    Get detailed rolling window statistics for a specific provider.
    """"
    try:
        stats = await provider_statistics_integration.stats_manager.get_provider_statistics(provider_id)
        
        if not stats:
            raise BusinessLogicException(f"Provider {provider_id} statistics not found", status_code=404)
        
        response = ProviderStatisticsResponse(
            provider_id=stats["provider_id"],
            confidence_score=stats["confidence_score"],
            data_freshness_score=stats["data_freshness_score"],
            overall_success_rate=stats["overall_success_rate"],
            uptime_hours=stats["uptime_hours"],
            success_rates=ProviderSuccessRates(**stats["success_rates"]),
            latency_percentiles=ProviderLatencyMetrics(**stats["latency_percentiles"]),
            request_rates_per_min=ProviderRequestRates(**stats["request_rates_per_min"]),
            trends=ProviderTrends(**stats["trends"]),
            total_requests=stats["total_requests"],
            total_successes=stats["total_successes"],
            last_request_age_sec=stats["last_request_age_sec"],
        )
        
        return response
        
    except HTTPException:
        raise
    except Exception as e:
        logger.error("Failed to get provider statistics", extra={
            "category": "provider_status_api",
            "action": "get_provider_statistics_error",
            "provider_id": provider_id,
            "error": str(e),
        })
        raise BusinessLogicException(f"Failed to retrieve provider statistics: {str(e)}, status_code=500)")


@router.get("/confidence-scores", response_model=ConfidenceScoreResponse)
async def get_provider_confidence_scores(
    top_limit: int = Query(5, description="Number of top providers to return"),
    _: None = Depends(ensure_integration_started)
):
    """
    Get confidence scores for all providers and top performers.
    """"
    try:
        all_scores = await provider_statistics_integration.stats_manager.get_provider_confidence_scores()
        top_providers = await provider_statistics_integration.stats_manager.get_top_providers_by_confidence(top_limit)
        
        response = ConfidenceScoreResponse(
            provider_scores=all_scores,
            top_providers=top_providers
        )
        
        logger.info("Provider confidence scores retrieved", extra={
            "category": "provider_status_api",
            "action": "get_confidence_scores",
            "total_providers": len(all_scores),
            "top_limit": top_limit,
        })
        
        return response
        
    except Exception as e:
        logger.error("Failed to get confidence scores", extra={
            "category": "provider_status_api",
            "action": "get_confidence_scores_error",
            "error": str(e),
        })
        raise BusinessLogicException(f"Failed to retrieve confidence scores: {str(e)}, status_code=500)")


@router.get("/health/dashboard", response_model=SystemHealthDashboardResponse)
async def get_system_health_dashboard(
    _: None = Depends(ensure_integration_started)
):
    """
    Get comprehensive system health dashboard with provider distribution,
    top performers, and issue summary.
    """"
    try:
        dashboard = await provider_statistics_integration.get_system_health_dashboard()
        
        response = SystemHealthDashboardResponse(
            system_overview=SystemHealthSummary(**dashboard["system_overview"]),
            provider_distribution=ProviderDistribution(**dashboard["provider_distribution"]),
            top_providers=[TopProvider(**provider) for provider in dashboard["top_providers"]],
            system_issues=SystemIssuesSummary(**dashboard["system_issues"]),
        )
        
        logger.info("System health dashboard retrieved", extra={
            "category": "provider_status_api",
            "action": "get_health_dashboard",
            "total_providers": dashboard["system_overview"]["total_providers"],
            "system_health_score": dashboard["system_overview"]["system_health_score"],
            "total_issues": dashboard["system_issues"]["total_issues"],
        })
        
        return response
        
    except Exception as e:
        logger.error("Failed to get health dashboard", extra={
            "category": "provider_status_api",
            "action": "get_health_dashboard_error",
            "error": str(e),
        })
        raise BusinessLogicException(f"Failed to retrieve health dashboard: {str(e)}, status_code=500)")


@router.get("/issues", response_model=Dict[str, List[Dict[str, Any]]])
async def get_provider_issues(
    _: None = Depends(ensure_integration_started)
):
    """
    Get detailed provider issues categorized by type.
    """"
    try:
        issues = await provider_statistics_integration.detect_provider_issues()
        
        logger.info("Provider issues retrieved", extra={
            "category": "provider_status_api",
            "action": "get_provider_issues",
            "total_issues": sum(len(issue_list) for issue_list in issues.values()),
            "issue_categories": list(issues.keys()),
        })
        
        return issues
        
    except Exception as e:
        logger.error("Failed to get provider issues", extra={
            "category": "provider_status_api",
            "action": "get_provider_issues_error",
            "error": str(e),
        })
        raise BusinessLogicException(f"Failed to retrieve provider issues: {str(e)}, status_code=500)")


@router.get("/recommended", response_model=List[ProviderHealthResponse])
async def get_recommended_providers(
    limit: int = Query(5, description="Maximum number of providers to return"),
    _: None = Depends(ensure_integration_started)
):
    """
    Get top recommended providers for use based on comprehensive health assessment.
    """"
    try:
        recommended = await provider_statistics_integration.get_recommended_providers(limit)
        
        response = []
        for health in recommended:
            response.append(ProviderHealthResponse(
                provider_id=health.provider_id,
                consecutive_failures=health.consecutive_failures,
                circuit_state=health.circuit_state,
                provider_state=health.provider_state,
                can_retry=health.can_retry,
                retry_after_sec=health.retry_after_sec,
                confidence_score=health.confidence_score,
                success_rates=ProviderSuccessRates(**health.success_rates),
                latency_percentiles=transform_latency_percentiles(health.latency_percentiles),
                request_rates_per_min=ProviderRequestRates(**health.request_rates_per_min),
                trends=ProviderTrends(**health.trends),
                data_freshness_score=health.data_freshness_score,
                overall_health_status=health.overall_health_status,
                is_recommended=health.is_recommended,
                priority_rank=health.priority_rank,
            ))
        
        logger.info("Recommended providers retrieved", extra={
            "category": "provider_status_api",
            "action": "get_recommended_providers",
            "provider_count": len(response),
            "limit": limit,
        })
        
        return response
        
    except Exception as e:
        logger.error("Failed to get recommended providers", extra={
            "category": "provider_status_api",
            "action": "get_recommended_providers_error",
            "error": str(e),
        })
        raise BusinessLogicException(f"Failed to retrieve recommended providers: {str(e)}, status_code=500)")


# Add routes to the main router
def include_provider_status_routes(app_router):
    """Include provider status routes in the main application router"""
    app_router.include_router(router)
