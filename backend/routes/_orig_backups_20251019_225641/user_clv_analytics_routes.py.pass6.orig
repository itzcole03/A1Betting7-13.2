    """Create empty analytics response for users with no bets"""
    return UserCLVAnalyticsResponse(
        user_id=user_id,
        period_start=period_start,
        period_end=period_end,
        clv_metrics=CLVPerformanceMetrics(
            avg_clv_percent=None,
            median_clv_percent=None,
            positive_clv_rate=0.0,
            total_bets=0,
            bets_with_clv=0,
            clv_distribution={},
            best_clv=None,
            worst_clv=None,
            clv_consistency_score=None
        ),
        profitability=ProfitabilityMetrics(
            total_stake=None,
            total_profit_loss=None,
            roi_percent=None,
            win_rate=None,
            avg_stake=None,
            settled_bets=0,
            winning_bets=0,
            losing_bets=0,
            push_bets=0
        ),
        breakdowns=SportMarketBreakdown(
            sport_performance={},
            market_performance={},
            best_sport=None,
            best_market=None,
            worst_sport=None,
            worst_market=None
        ),
        achievements=[],
        ranking=None,
        recent_trends={},
        recommendations=["Start placing bets to see CLV analytics!"]
    )


def _calculate_clv_metrics(bets: List[CLVBetTracking]) -> CLVPerformanceMetrics:
    """Calculate CLV performance metrics from bet list"""
    total_bets = len(bets)
    bets_with_clv = [bet for bet in bets if getattr(bet, 'clv_status') == CLVComputationStatus.COMPUTED]
    
    if not bets_with_clv:
        return CLVPerformanceMetrics(
            avg_clv_percent=None,
            median_clv_percent=None,
            positive_clv_rate=0.0,
            total_bets=total_bets,
            bets_with_clv=0,
            clv_distribution={},
            best_clv=None,
            worst_clv=None,
            clv_consistency_score=None
        )
    
    clv_values = [getattr(bet, 'clv_percent') for bet in bets_with_clv if getattr(bet, 'clv_percent') is not None]
    
    if not clv_values:
        return CLVPerformanceMetrics(
            avg_clv_percent=None,
            median_clv_percent=None,
            positive_clv_rate=0.0,
            total_bets=total_bets,
            bets_with_clv=len(bets_with_clv),
            clv_distribution={},
            best_clv=None,
            worst_clv=None,
            clv_consistency_score=None
        )
    
    # Calculate basic stats
    avg_clv = sum(clv_values) / len(clv_values)
    median_clv = statistics.median(clv_values)
    positive_count = sum(1 for clv in clv_values if clv > 0)
    positive_rate = (positive_count / len(clv_values)) * 100
    
    # Calculate distribution
    distribution = {
        "excellent": sum(1 for clv in clv_values if clv >= 10),
        "good": sum(1 for clv in clv_values if 5 <= clv < 10),
        "positive": sum(1 for clv in clv_values if 0 <= clv < 5),
        "slight_negative": sum(1 for clv in clv_values if -5 <= clv < 0),
        "poor": sum(1 for clv in clv_values if clv < -5)
    }
    
    # Calculate consistency score (inverse of coefficient of variation)
    consistency_score = None
    if len(clv_values) > 1:
        try:
            std_dev = statistics.stdev(clv_values)
            if avg_clv != 0:
                cv = abs(std_dev / avg_clv)
                consistency_score = max(0, min(1, 1 - (cv / 2)))  # Normalize to 0-1
        except statistics.StatisticsError:
            pass
    
    return CLVPerformanceMetrics(
        avg_clv_percent=round(avg_clv, 2),
        median_clv_percent=round(median_clv, 2),
        positive_clv_rate=round(positive_rate, 1),
        total_bets=total_bets,
        bets_with_clv=len(bets_with_clv),
        clv_distribution=distribution,
        best_clv=round(max(clv_values), 2),
        worst_clv=round(min(clv_values), 2),
        clv_consistency_score=round(consistency_score, 3) if consistency_score is not None else None
    )


def _calculate_profitability_metrics(bets: List[CLVBetTracking]) -> ProfitabilityMetrics:
    """Calculate profitability metrics from bet list"""
    settled_bets = [bet for bet in bets if getattr(bet, 'bet_result') is not None]
    
    if not settled_bets:
        return ProfitabilityMetrics(
            total_stake=sum(getattr(bet, 'stake_amount') for bet in bets),
            total_profit_loss=None,
            roi_percent=None,
            win_rate=None,
            avg_stake=sum(getattr(bet, 'stake_amount') for bet in bets) / len(bets) if bets else None,
            settled_bets=0,
            winning_bets=0,
            losing_bets=0,
            push_bets=0
        )
    
    # Calculate profit/loss stats
    profit_loss_values = [getattr(bet, 'profit_loss') for bet in settled_bets if getattr(bet, 'profit_loss') is not None]
    total_profit_loss = sum(profit_loss_values) if profit_loss_values else None
    
    total_stake = sum(getattr(bet, 'stake_amount') for bet in bets)
    roi_percent = calculate_roi_percent(total_profit_loss, total_stake) if total_profit_loss is not None else None
    
    # Calculate win/loss counts
    winning_bets = sum(1 for bet in settled_bets if getattr(bet, 'bet_result') == 'win')
    losing_bets = sum(1 for bet in settled_bets if getattr(bet, 'bet_result') == 'loss')
    push_bets = sum(1 for bet in settled_bets if getattr(bet, 'bet_result') == 'push')
    
    win_rate = calculate_win_rate(winning_bets, len(settled_bets)) if settled_bets else None
    
    return ProfitabilityMetrics(
        total_stake=total_stake,
        total_profit_loss=total_profit_loss,
        roi_percent=roi_percent,
        win_rate=win_rate,
        avg_stake=total_stake / len(bets) if bets else None,
        settled_bets=len(settled_bets),
        winning_bets=winning_bets,
        losing_bets=losing_bets,
        push_bets=push_bets
    )


def _calculate_sport_market_breakdowns(bets: List[CLVBetTracking]) -> SportMarketBreakdown:
    """Calculate sport and market performance breakdowns"""
    bets_with_clv = [bet for bet in bets if getattr(bet, 'clv_percent') is not None]
    
    if not bets_with_clv:
        return SportMarketBreakdown(
            sport_performance={},
            market_performance={},
            best_sport=None,
            best_market=None,
            worst_sport=None,
            worst_market=None
        )
    
    # Group by sport
    sport_groups = {}
    for bet in bets_with_clv:
        sport = getattr(bet, 'sport')
        if sport not in sport_groups:
            sport_groups[sport] = []
        sport_groups[sport].append(getattr(bet, 'clv_percent'))
    
    # Group by market
    market_groups = {}
    for bet in bets_with_clv:
        market = getattr(bet, 'market')
        if market not in market_groups:
            market_groups[market] = []
        market_groups[market].append(getattr(bet, 'clv_percent'))
    
    # Calculate sport performance
    sport_performance = {}
    for sport, clv_values in sport_groups.items():
        sport_performance[sport] = {
            "avg_clv": round(sum(clv_values) / len(clv_values), 2),
            "count": len(clv_values),
            "positive_rate": round((sum(1 for clv in clv_values if clv > 0) / len(clv_values)) * 100, 1)
        }
    
    # Calculate market performance
    market_performance = {}
    for market, clv_values in market_groups.items():
        market_performance[market] = {
            "avg_clv": round(sum(clv_values) / len(clv_values), 2),
            "count": len(clv_values),
            "positive_rate": round((sum(1 for clv in clv_values if clv > 0) / len(clv_values)) * 100, 1)
        }
    
    # Find best/worst performers
    best_sport = max(sport_performance.keys(), key=lambda x: sport_performance[x]["avg_clv"]) if sport_performance else None
    worst_sport = min(sport_performance.keys(), key=lambda x: sport_performance[x]["avg_clv"]) if sport_performance else None
    best_market = max(market_performance.keys(), key=lambda x: market_performance[x]["avg_clv"]) if market_performance else None
    worst_market = min(market_performance.keys(), key=lambda x: market_performance[x]["avg_clv"]) if market_performance else None
    
    return SportMarketBreakdown(
        sport_performance=sport_performance,
        market_performance=market_performance,
        best_sport=best_sport,
        best_market=best_market,
        worst_sport=worst_sport,
        worst_market=worst_market
    )


