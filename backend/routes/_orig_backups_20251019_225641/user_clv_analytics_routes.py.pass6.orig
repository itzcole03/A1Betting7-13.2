"""
User CLV Analytics Routes

API endpoints for retrieving comprehensive user CLV analytics and performance metrics
""""

from fastapi import APIRouter, HTTPException, Depends, Query
from sqlalchemy.orm import Session
from sqlalchemy import func, and_, or_, desc
from datetime import datetime, timezone, timedelta
from typing import Optional, List, Dict, Any
from pydantic import BaseModel, Field
import statistics
from backend.core.exceptions import BusinessLogicException

from backend.models.clv_bet_tracking import CLVBetTracking, CLVAnalyticsSummary, CLVLeaderboard, CLVComputationStatus
from backend.utils.clv_utils import get_clv_tier, get_achievement_badges, calculate_roi_percent, calculate_win_rate
from backend.database import get_db
from backend.auth.security import get_current_user
router = APIRouter(prefix="/api/users", tags=["User CLV Analytics"])


# Response Models
class CLVPerformanceMetrics(BaseModel):
    """CLV performance metrics response"""
    avg_clv_percent: Optional[float]
    median_clv_percent: Optional[float]
    positive_clv_rate: float
    total_bets: int
    bets_with_clv: int
    clv_distribution: Dict[str, int]
    best_clv: Optional[float]
    worst_clv: Optional[float]
    clv_consistency_score: Optional[float]


class ProfitabilityMetrics(BaseModel):
    """Profitability and outcome metrics"""
    total_stake: Optional[float]
    total_profit_loss: Optional[float]
    roi_percent: Optional[float]
    win_rate: Optional[float]
    avg_stake: Optional[float]
    settled_bets: int
    winning_bets: int
    losing_bets: int
    push_bets: int


class SportMarketBreakdown(BaseModel):
    """Sport and market performance breakdown"""
    sport_performance: Dict[str, Dict[str, Any]]
    market_performance: Dict[str, Dict[str, Any]]
    best_sport: Optional[str]
    best_market: Optional[str]
    worst_sport: Optional[str]
    worst_market: Optional[str]


class UserCLVAnalyticsResponse(BaseModel):
    """Complete user CLV analytics response"""
    user_id: str
    period_start: datetime
    period_end: datetime
    clv_metrics: CLVPerformanceMetrics
    profitability: ProfitabilityMetrics
    breakdowns: SportMarketBreakdown
    achievements: List[str]
    ranking: Optional[Dict[str, Any]]
    recent_trends: Dict[str, Any]
    recommendations: List[str]


@router.get("/{user_id}/clv", response_model=UserCLVAnalyticsResponse)
async def get_user_clv_analytics(
    user_id: str,
    days: int = Query(30, ge=1, le=365, description="Number of days to analyze"),
    sport: Optional[str] = Query(None, description="Filter by specific sport"),
    market: Optional[str] = Query(None, description="Filter by specific market"),
    include_ranking: bool = Query(True, description="Include user ranking data"),
    db: Session = Depends(get_db),
    current_user = Depends(get_current_user)
):
    """
    Get comprehensive CLV analytics for a user
    
    Provides detailed CLV performance metrics, profitability analysis,
    sport/market breakdowns, achievements, and recommendations.
    """"
    # Security check - users can only access their own data
    if user_id != current_user.id:
        raise BusinessLogicException("Access denied", status_code=403)
    
    try:
        period_start = datetime.now(timezone.utc) - timedelta(days=days)
        period_end = datetime.now(timezone.utc)
        
        # Build base query for user's bets in the period'
        base_query = db.query(CLVBetTracking).filter(
            CLVBetTracking.user_id == user_id,
            CLVBetTracking.placed_at >= period_start,
            CLVBetTracking.placed_at <= period_end
        )
        
        # Apply filters
        if sport:
            base_query = base_query.filter(CLVBetTracking.sport == sport)
        if market:
            base_query = base_query.filter(CLVBetTracking.market == market)
        
        # Get all bets
        all_bets = base_query.all()
        
        if not all_bets:
            # Return empty analytics for no bets
            return _create_empty_analytics(user_id, period_start, period_end)
        
        # Calculate CLV performance metrics
        clv_metrics = _calculate_clv_metrics(all_bets)
        
        # Calculate profitability metrics
        profitability = _calculate_profitability_metrics(all_bets)
        
        # Calculate sport/market breakdowns
        breakdowns = _calculate_sport_market_breakdowns(all_bets)
        
        # Get achievements
        user_stats = {
            "avg_clv_percent": clv_metrics.avg_clv_percent,
            "total_bets": clv_metrics.total_bets,
            "positive_clv_rate": clv_metrics.positive_clv_rate,
            "win_rate": profitability.win_rate
        }
        achievements = get_achievement_badges(user_stats)
        
        # Get ranking data if requested
        ranking = None
        if include_ranking:
            ranking = await _get_user_ranking(db, user_id)
        
        # Calculate recent trends
        recent_trends = _calculate_recent_trends(db, user_id, period_start)
        
        # Generate recommendations
        recommendations = _generate_recommendations(clv_metrics, profitability, breakdowns)
        
        return UserCLVAnalyticsResponse(
            user_id=user_id,
            period_start=period_start,
            period_end=period_end,
            clv_metrics=clv_metrics,
            profitability=profitability,
            breakdowns=breakdowns,
            achievements=achievements,
            ranking=ranking,
            recent_trends=recent_trends,
            recommendations=recommendations
        )
        
    except Exception as e:
        raise BusinessLogicException(f"Failed to get CLV analytics: {str(e)}, status_code=500)")


@router.get("/{user_id}/clv/summary")
async def get_user_clv_summary(
    user_id: str,
    db: Session = Depends(get_db),
    current_user = Depends(get_current_user)
):
    """
    Get a quick CLV summary for dashboard display
    """"
    if user_id != current_user.id:
        raise BusinessLogicException("Access denied", status_code=403)
    
    try:
        # Get 30-day stats
        period_start = datetime.now(timezone.utc) - timedelta(days=30)
        
        bets_with_clv = db.query(CLVBetTracking).filter(
            CLVBetTracking.user_id == user_id,
            CLVBetTracking.placed_at >= period_start,
            CLVBetTracking.clv_status == CLVComputationStatus.COMPUTED
        ).all()
        
        if not bets_with_clv:
            return {
                "avg_clv": None,
                "total_bets": 0,
                "positive_clv_rate": 0,
                "clv_tier": "unknown",
                "recent_trend": "neutral"
            }
        
        clv_values = [getattr(bet, 'clv_percent') for bet in bets_with_clv if getattr(bet, 'clv_percent') is not None]
        
        if clv_values:
            avg_clv = sum(clv_values) / len(clv_values)
            positive_count = sum(1 for clv in clv_values if clv > 0)
            positive_rate = (positive_count / len(clv_values)) * 100
            
            # Calculate recent trend (last 7 days vs previous 7 days)
            week_ago = datetime.now(timezone.utc) - timedelta(days=7)
            two_weeks_ago = datetime.now(timezone.utc) - timedelta(days=14)
            
            recent_clv = [getattr(bet, 'clv_percent') for bet in bets_with_clv 
                         if getattr(bet, 'placed_at') >= week_ago and getattr(bet, 'clv_percent') is not None]
            previous_clv = [getattr(bet, 'clv_percent') for bet in bets_with_clv 
                           if two_weeks_ago <= getattr(bet, 'placed_at') < week_ago and getattr(bet, 'clv_percent') is not None]
            
            trend = "neutral"
            if recent_clv and previous_clv:
                recent_avg = sum(recent_clv) / len(recent_clv)
                previous_avg = sum(previous_clv) / len(previous_clv)
                if recent_avg > previous_avg + 1:
                    trend = "improving"
                elif recent_avg < previous_avg - 1:
                    trend = "declining"
            
            return {
                "avg_clv": round(avg_clv, 2),
                "total_bets": len(bets_with_clv),
                "positive_clv_rate": round(positive_rate, 1),
                "clv_tier": get_clv_tier(avg_clv),
                "recent_trend": trend
            }
        else:
            return {
                "avg_clv": None,
                "total_bets": len(bets_with_clv),
                "positive_clv_rate": 0,
                "clv_tier": "unknown",
                "recent_trend": "neutral"
            }
            
    except Exception as e:
        raise BusinessLogicException(f"Failed to get CLV summary: {str(e)}, status_code=500)")


@router.get("/{user_id}/clv/history")
async def get_user_clv_history(
    user_id: str,
    days: int = Query(90, ge=7, le=365, description="Number of days of history"),
    granularity: str = Query("daily", regex="^(daily|weekly|monthly)$", description="Time granularity"),
    db: Session = Depends(get_db),
    current_user = Depends(get_current_user)
):
    """
    Get CLV performance history over time for charting
    """"
    if user_id != current_user.id:
        raise BusinessLogicException("Access denied", status_code=403)
    
    try:
        period_start = datetime.now(timezone.utc) - timedelta(days=days)
        
        # Get all bets with CLV in the period
        bets = db.query(CLVBetTracking).filter(
            CLVBetTracking.user_id == user_id,
            CLVBetTracking.placed_at >= period_start,
            CLVBetTracking.clv_status == CLVComputationStatus.COMPUTED
        ).order_by(CLVBetTracking.placed_at).all()
        
        if not bets:
            return {"data_points": [], "summary": {"total_periods": 0, "avg_clv": None}}
        
        # Group bets by time period
        history_data = _group_bets_by_period(bets, granularity)
        
        return {
            "data_points": history_data,
            "summary": {
                "total_periods": len(history_data),
                "avg_clv": sum(point["avg_clv"] for point in history_data if point["avg_clv"] is not None) / len(history_data) if history_data else None
            }
        }
        
    except Exception as e:
        raise BusinessLogicException(f"Failed to get CLV history: {str(e)}, status_code=500)")


# Helper functions
