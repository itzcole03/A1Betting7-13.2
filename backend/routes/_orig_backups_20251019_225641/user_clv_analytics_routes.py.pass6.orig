def _calculate_recent_trends(db: Session, user_id: str, period_start: datetime) -> Dict[str, Any]:
    """Calculate recent performance trends"""
    # Calculate 7-day and 30-day trends
    week_ago = datetime.now(timezone.utc) - timedelta(days=7)
    
    recent_bets = db.query(CLVBetTracking).filter(
        CLVBetTracking.user_id == user_id,
        CLVBetTracking.placed_at >= week_ago,
        CLVBetTracking.clv_status == CLVComputationStatus.COMPUTED
    ).all()
    
    recent_clv_values = [getattr(bet, 'clv_percent') for bet in recent_bets if getattr(bet, 'clv_percent') is not None]
    
    return {
        "recent_7d_bets": len(recent_bets),
        "recent_7d_avg_clv": round(sum(recent_clv_values) / len(recent_clv_values), 2) if recent_clv_values else None,
        "momentum": "neutral"  # Could implement more sophisticated trend analysis
    }


def _generate_recommendations(
    clv_metrics: CLVPerformanceMetrics, 
    profitability: ProfitabilityMetrics, 
    breakdowns: SportMarketBreakdown
) -> List[str]:
    """Generate personalized recommendations based on performance"""
    recommendations = []
    
    if clv_metrics.avg_clv_percent is not None:
        if clv_metrics.avg_clv_percent < 0:
            recommendations.append("Focus on improving bet selection - your average CLV is negative")
        elif clv_metrics.avg_clv_percent < 2:
            recommendations.append("Look for higher-value betting opportunities to improve your CLV")
        else:
            recommendations.append("Great CLV performance! Keep focusing on value betting")
    
    if clv_metrics.positive_clv_rate < 50:
        recommendations.append("Try to increase your positive CLV rate above 50%")
    
    if breakdowns.best_sport and breakdowns.worst_sport:
        recommendations.append(f"Consider focusing more on {breakdowns.best_sport} - your best performing sport")
    
    if clv_metrics.clv_consistency_score is not None and clv_metrics.clv_consistency_score < 0.3:
        recommendations.append("Work on consistency - your CLV varies significantly between bets")
    
    if not recommendations:
        recommendations.append("Keep up the good work! Continue focusing on value betting")
    
    return recommendations


