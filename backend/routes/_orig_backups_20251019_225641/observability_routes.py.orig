"""
Observability Routes

Provides internal API endpoints for observability snapshots, metrics, and health monitoring.
Includes the /api/observability/snapshot endpoint that returns baseline keys even with zero data.
"""

import logging
from typing import Any, Dict

from fastapi import APIRouter, Body, HTTPException, status
from fastapi.responses import JSONResponse

from backend.core.exceptions import BusinessLogicException

from ..services.instrumentation_service import instrumentation_service

logger = logging.getLogger("a1betting.observability_routes")

router = APIRouter(prefix="/api/observability", tags=["Observability"])


@router.get("/snapshot")
async def get_observability_snapshot() -> Dict[str, Any]:
    """
    Get comprehensive observability snapshot with baseline keys

    Returns timing averages, recent errors, and active flags.
    Always returns baseline structure even with zero data.

    Returns:
        Dict containing:
        - timings: {ev_ms_avg, arbitrage_ms_avg, odds_norm_ms_avg, line_movement_ms_avg}
        - recentErrors: List of recent error events
        - activeFlags: Current feature flag values
        - Additional diagnostic information
    """
    try:
        snapshot = await instrumentation_service.get_observability_snapshot()

        # Ensure baseline keys are always present
        baseline_snapshot = {
            "timings": {
                "ev_ms_avg": 0.0,
                "arbitrage_ms_avg": 0.0,
                "odds_norm_ms_avg": 0.0,
                "line_movement_ms_avg": 0.0,
            },
            "recentErrors": [],
            "activeFlags": {
                "tracing_enabled": True,
                "error_hashing_enabled": True,
                "metrics_collection_enabled": True,
                "span_sampling_rate": 1.0,
                "max_span_duration_warn_ms": 5000,
            },
        }

        # Merge with actual data, ensuring baseline structure
        baseline_snapshot.update(snapshot)

        # Ensure timings dict has all required keys
        timings = baseline_snapshot.get("timings", {})
        for key in [
            "ev_ms_avg",
            "arbitrage_ms_avg",
            "odds_norm_ms_avg",
            "line_movement_ms_avg",
        ]:
            if key not in timings:
                timings[key] = 0.0

        baseline_snapshot["timings"] = timings

        logger.debug("Observability snapshot generated successfully")
        return baseline_snapshot

    except Exception as e:
        logger.error(f"Failed to generate observability snapshot: {e}")

        # Return baseline structure even on error
        return {
            "timings": {
                "ev_ms_avg": 0.0,
                "arbitrage_ms_avg": 0.0,
                "odds_norm_ms_avg": 0.0,
                "line_movement_ms_avg": 0.0,
            },
            "recentErrors": [
                {
                    "error_hash": "snapshot_generation_failed",
                    "operation": "observability_snapshot",
                    "timestamp": "2024-01-01T00:00:00Z",
                    "error_type": "SnapshotGenerationError",
                    "error_message": str(e),
                }
            ],
            "activeFlags": {
                "tracing_enabled": True,
                "error_hashing_enabled": True,
                "metrics_collection_enabled": True,
                "span_sampling_rate": 1.0,
                "max_span_duration_warn_ms": 5000,
            },
            "error": "Failed to generate snapshot",
            "errorDetails": str(e),
        }


@router.get("/health")
async def get_instrumentation_health() -> Dict[str, Any]:
    """
    Get instrumentation service health status

    Returns:
        Dict containing health status and metrics
    """
    try:
        health_status = await instrumentation_service.get_health_status()
        return health_status

    except Exception as e:
        logger.error(f"Failed to get instrumentation health: {e}")
        raise BusinessLogicException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
            detail=f"Health check failed: {e}",
        )


@router.get("/metrics/operations")
async def get_operation_metrics() -> Dict[str, Any]:
    """
    Get detailed operation metrics

    Returns:
        Dict containing metrics for all tracked operations
    """
    try:
        snapshot = await instrumentation_service.get_observability_snapshot()
        return {
            "operationMetrics": snapshot.get("operationMetrics", {}),
            "timestamp": snapshot.get("snapshotTimestamp"),
            "activeSpans": snapshot.get("activeSpans", 0),
            "completedSpans": snapshot.get("completedSpans", 0),
        }

    except Exception as e:
        logger.error(f"Failed to get operation metrics: {e}")
        raise BusinessLogicException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
            detail=f"Metrics retrieval failed: {e}",
        )


@router.get("/errors/summary")
async def get_error_summary() -> Dict[str, Any]:
    """
    Get structured error summary with hashed groupings

    Returns:
        Dict containing error summaries grouped by hash
    """
    try:
        snapshot = await instrumentation_service.get_observability_snapshot()
        return {
            "errorSummaries": snapshot.get("errorSummaries", []),
            "recentErrors": snapshot.get("recentErrors", []),
            "totalErrorHashes": len(snapshot.get("errorSummaries", [])),
            "recentErrorCount": len(snapshot.get("recentErrors", [])),
            "timestamp": snapshot.get("snapshotTimestamp"),
        }

    except Exception as e:
        logger.error(f"Failed to get error summary: {e}")
        raise BusinessLogicException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
            detail=f"Error summary retrieval failed: {e}",
        )


@router.post("/flags/{flag_name}")
async def update_feature_flag(flag_name: str, value: Any = Body(...)) -> Dict[str, Any]:
    """
    Update a feature flag value

    Args:
        flag_name: Name of the flag to update
        value: New value for the flag

    Returns:
        Dict confirming the flag update
    """
    try:
        success = instrumentation_service.update_flag(flag_name, value)

        if success:
            return {
                "success": True,
                "flag": flag_name,
                "newValue": value,
                "message": f"Flag {flag_name} updated successfully",
            }
        else:
            raise BusinessLogicException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail=f"Flag {flag_name} not found",
            )

    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Failed to update flag {flag_name}: {e}")
        raise BusinessLogicException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
            detail=f"Flag update failed: {e}",
        )


@router.get("/flags")
async def get_feature_flags() -> Dict[str, Any]:
    """
    Get all current feature flag values

    Returns:
        Dict containing all active flags
    """
    try:
        snapshot = await instrumentation_service.get_observability_snapshot()
        return {
            "activeFlags": snapshot.get("activeFlags", {}),
            "timestamp": snapshot.get("snapshotTimestamp"),
        }

    except Exception as e:
        logger.error(f"Failed to get feature flags: {e}")
        raise BusinessLogicException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
            detail=f"Feature flag retrieval failed: {e}",
        )


@router.post("/clear-metrics")
async def clear_all_metrics() -> Dict[str, Any]:
    """
    Clear all instrumentation metrics (useful for testing)

    Returns:
        Dict confirming metrics were cleared
    """
    try:
        instrumentation_service.clear_metrics()
        return {
            "success": True,
            "message": "All instrumentation metrics cleared",
            "timestamp": "2024-01-01T00:00:00Z",
        }

    except Exception as e:
        logger.error(f"Failed to clear metrics: {e}")
        raise BusinessLogicException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
            detail=f"Metrics clearing failed: {e}",
        )


@router.get("/timings")
async def get_timing_data() -> Dict[str, Any]:
    """
    Get just the timing data from observability snapshot

    Returns:
        Dict containing timing averages for key operations
    """
    try:
        snapshot = await instrumentation_service.get_observability_snapshot()
        return {
            "timings": snapshot.get(
                "timings",
                {
                    "ev_ms_avg": 0.0,
                    "arbitrage_ms_avg": 0.0,
                    "odds_norm_ms_avg": 0.0,
                    "line_movement_ms_avg": 0.0,
                },
            ),
            "timestamp": snapshot.get("snapshotTimestamp"),
        }

    except Exception as e:
        logger.error(f"Failed to get timing data: {e}")
        # Return baseline timing structure on error
        return {
            "timings": {
                "ev_ms_avg": 0.0,
                "arbitrage_ms_avg": 0.0,
                "odds_norm_ms_avg": 0.0,
                "line_movement_ms_avg": 0.0,
            },
            "error": "Failed to get timing data",
            "errorDetails": str(e),
            "timestamp": "2024-01-01T00:00:00Z",
        }


# Health check endpoint specifically for observability system
@router.get("/status")
async def get_observability_status() -> JSONResponse:
    """
    Get high-level observability system status

    Returns:
        JSON response with observability system health
    """
    try:
        health = await instrumentation_service.get_health_status()

        status_code = status.HTTP_200_OK
        if health.get("status") != "healthy":
            status_code = status.HTTP_503_SERVICE_UNAVAILABLE

        return JSONResponse(
            status_code=status_code,
            content={
                "status": health.get("status", "unknown"),
                "observabilityEnabled": True,
                "tracingEnabled": health.get("flags", {}).get("tracing_enabled", True),
                "metricsEnabled": health.get("flags", {}).get(
                    "metrics_collection_enabled", True
                ),
                "errorTrackingEnabled": health.get("flags", {}).get(
                    "error_hashing_enabled", True
                ),
                "activeOperations": health.get("tracked_operations", 0),
                "lastHealthCheck": health.get("last_health_check"),
            },
        )

    except Exception as e:
        logger.error(f"Observability status check failed: {e}")
        raise BusinessLogicException(str(e), status_code=500)
