# Compatibility helper: convert legacy `ok()` payloads into the canonical response envelope
def _ok_as_response(data: Any) -> Dict[str, Any]:
    """Wrap legacy ok() payload into StandardAPIResponse via ResponseBuilder.

    This creates a ResponseBuilder and returns ResponseBuilder.success(builder.success(data)).
    Used to ensure legacy endpoints return the {success,data,error} envelope that contract
    tests expect without changing the legacy `ok()` helper.
    """
    builder = ResponseBuilder()
    return ResponseBuilder.success(builder.success(data))


