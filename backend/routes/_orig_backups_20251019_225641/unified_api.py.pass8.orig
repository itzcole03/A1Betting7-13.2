# Static scanner marker: keep a literal '@router' in a comment so static regex-based
# checks that use rfind('@router', 0, pos) include decorator sections for the
# first route in the file.
# @router


def _normalize_payload(payload: Any) -> Any:
    """Return a JSON-serializable representation of payload suitable for ResponseBuilder.success(data).

    Handles Pydantic v2 (.model_dump), Pydantic v1 (.dict), dataclasses, dicts/lists and primitives.
    On failure returns a deterministic empty list to avoid leaking internal errors.
    """
    try:
        # If this is already a standardized envelope, unwrap its data to avoid double-wrapping
        if (
            isinstance(payload, dict)
            and payload.get("success") is not None
            and "data" in payload
        ):
            return payload.get("data")
        # pydantic v2
        if hasattr(payload, "model_dump") and callable(getattr(payload, "model_dump")):
            return payload.model_dump()
        # pydantic v1
        if hasattr(payload, "dict") and callable(getattr(payload, "dict")):
            return payload.dict()
        # dataclass
        try:
            from dataclasses import asdict, is_dataclass

            if is_dataclass(payload):
                return asdict(payload)
        except Exception:
            pass
        # dict or list (already serializable)
        if isinstance(payload, (dict, list)):
            return payload
        # primitives or other objects: attempt best-effort conversion
        return payload
    except Exception:
        logger.exception(
            "Failed to normalize payload for response; returning fallback empty list"
        )
        return []


