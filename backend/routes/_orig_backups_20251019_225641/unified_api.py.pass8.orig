@router.post("/predictions", response_model=dict, tags=["Unified Intelligence"])
@router.post("/unified/predictions", response_model=dict, tags=["Unified Intelligence"])
async def api_predictions(request: Request) -> dict:
    """
    Alias for /unified/batch-predictions. Returns standardized response contract.
    """
    result = await batch_predictions(request)
    # batch_predictions returns a standardized success dict; extract predictions list
    if (
        isinstance(result, dict)
        and "success" in result
        and isinstance(result.get("data"), dict)
    ):
        inner = result.get("data")
        # expect inner to contain 'predictions'
        preds = inner.get("predictions") if isinstance(inner, dict) else None
        return ResponseBuilder.success(preds or [])
    return ResponseBuilder.success(result)


