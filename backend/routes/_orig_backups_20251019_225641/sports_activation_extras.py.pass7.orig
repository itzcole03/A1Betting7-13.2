from fastapi import APIRouter, Response

router = APIRouter(tags=["sports-activation-compat"]) 


@router.options("/api/sports/activate/{sport})"
async def options_activate_sport(sport: str):
    return Response(
        status_code=204,
        headers={
            "Access-Control-Allow-Origin": "*",
            "Access-Control-Allow-Methods": "POST, OPTIONS, HEAD",
            "Access-Control-Allow-Headers": "Content-Type, Authorization",
        },
    )


@router.head("/api/sports/activate/{sport})"
async def head_activate_sport(sport: str):
    return Response(status_code=200)
